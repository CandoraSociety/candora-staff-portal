{
  "name": "KioskStation",
  "type": "object",
  "description": "A customer-facing tablet running the kiosk screen (for example the tablet on the counter at the front desk, or the wall tablet in one of the classrooms). Each station pairs with a short access code typed on the tablet once, then receives whatever its portal sends it. Classroom tablets are assigned to a physical room, so whatever is scheduled in that room opens its check-in \u2014 whichever program the class belongs to. The childminding tablet is assigned to the childminding room and follows the sessions booked in the Childminding portal.",
  "properties": {
    "name": {
      "type": "string",
      "description": "Name shown to staff, e.g. Front Desk Tablet or Large Classroom Tablet"
    },
    "program": {
      "type": "string",
      "enum": [
        "reception",
        "classroom",
        "central_registration",
        "ell",
        "empoweru",
        "frn"
      ],
      "default": "reception",
      "description": "reception = the front-desk kiosk; classroom = a wall tablet in one of the teaching rooms, including the childminding room"
    },
    "room": {
      "type": "string",
      "enum": [
        "large_classroom",
        "small_classroom",
        "employment_classroom",
        "arc",
        "echo_valley",
        "childminding",
        "other"
      ],
      "description": "Physical room the classroom tablet is mounted in \u2014 its schedule comes from what is booked in this room. The childminding room only ever follows Childminding sessions."
    },
    "location": {
      "type": "string",
      "description": "Where the tablet sits, e.g. Main lobby or Large Classroom"
    },
    "access_code": {
      "type": "string",
      "description": "Short code typed on the tablet to pair it with this station"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Turn off to disconnect the tablet \u2014 it stops receiving prompts"
    },
    "last_seen": {
      "type": "string",
      "format": "date-time",
      "description": "Last time the tablet checked in \u2014 used for the connected indicator"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "access_code"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}