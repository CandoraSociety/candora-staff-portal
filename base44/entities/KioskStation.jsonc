{
  "name": "KioskStation",
  "type": "object",
  "description": "A customer-facing tablet running the kiosk screen (for example the tablet on the counter at the front desk). Each station pairs with a short access code typed on the tablet once, then receives whatever the reception portal sends it.",
  "properties": {
    "name": {
      "type": "string",
      "description": "Name shown to staff, e.g. Front Desk Tablet"
    },
    "access_code": {
      "type": "string",
      "description": "Short code typed on the tablet to pair it with this station"
    },
    "location": {
      "type": "string",
      "description": "Where the tablet sits, e.g. Main lobby"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Turn off to disconnect the tablet \u2014 it stops receiving prompts"
    },
    "last_seen": {
      "type": "string",
      "format": "date-time",
      "description": "Last time the tablet checked in \u2014 used for the connected indicator"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "access_code"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}