{
  "name": "InterviewGuide",
  "type": "object",
  "description": "One interactive media interview preparation guide - who it is for, the show and date, the narrator voice, the spoken narration for its sections, and the quick-reference material. The questions themselves live in InterviewGuideQuestion. Staff create and publish a guide; the spokesperson opens it through its own secure link and can read, listen and practise without an app account.",
  "properties": {
    "title": {
      "type": "string",
      "description": "How the guide is labelled, e.g. Global Morning Show - Candora Interview Preparation"
    },
    "token": {
      "type": "string",
      "description": "Unguessable code in the guide's share link. Generated once when the guide is created."
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published",
        "archived"
      ],
      "enumColors": [
        "gray",
        "green",
        "purple"
      ],
      "default": "draft",
      "description": "draft = being built; published = the share link opens the guide; archived = finished interview, link closed"
    },
    "purpose": {
      "type": "string",
      "description": "One line on what this guide prepares the spokesperson for, shown at the top of the guide"
    },
    "spokesperson": {
      "type": "string",
      "description": "Staff member the guide is written for"
    },
    "outlet": {
      "type": "string",
      "description": "Where the interview appears, e.g. Global TV Edmonton"
    },
    "show_name": {
      "type": "string",
      "description": "Programme or segment, e.g. Global Morning Show"
    },
    "interviewer": {
      "type": "string",
      "description": "Journalist or host conducting the interview"
    },
    "interview_date": {
      "type": "string",
      "format": "date",
      "description": "Day the interview airs"
    },
    "voice": {
      "type": "string",
      "enum": [
        "nova",
        "shimmer",
        "sage",
        "coral",
        "marin"
      ],
      "enumColors": [
        "yellow",
        "pink",
        "blue",
        "green",
        "purple"
      ],
      "default": "nova",
      "description": "Narrator voice used when audio is generated for this guide - a North American female voice, neutral pronunciation. nova = warm and mature (recommended), shimmer = soft, sage = calm, coral = friendly, marin = natural."
    },
    "intro_narration": {
      "type": "string",
      "description": "Spoken welcome at the start of the guide - what this guide is for and how to use it"
    },
    "intro_audio_url": {
      "type": "string",
      "description": "Stored audio file of the intro narration, generated once and replayed without regenerating"
    },
    "key_messages_narration": {
      "type": "string",
      "description": "Spoken version of the key messages on their own, for a quick listen before going on air"
    },
    "key_messages_audio_url": {
      "type": "string",
      "description": "Stored audio file of the key messages narration"
    },
    "quick_reference_segments": {
      "type": "array",
      "description": "The spoken quick reference, one short clip per question, key message and cheat-sheet bullet, followed by the essential donation information and the on-air reminders. Read in the same order as the one-page quick reference.",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "cue",
              "heading",
              "question",
              "key",
              "point"
            ],
            "enumColors": [
              "gray",
              "purple",
              "blue",
              "green",
              "blue"
            ]
          },
          "text": {
            "type": "string",
            "description": "Exactly what the narrator says for this clip"
          },
          "category_label": {
            "type": "string",
            "description": "Section this clip belongs to, shown while it plays"
          },
          "category_index": {
            "type": "number",
            "description": "Position of the question this clip belongs to in the quick reference, for highlighting and per-question playback"
          },
          "point_index": {
            "type": "number",
            "description": "Position of this clip inside its section"
          },
          "pause_after_ms": {
            "type": "number",
            "description": "Silence left after this clip before the next one, in milliseconds"
          },
          "audio_url": {
            "type": "string"
          },
          "voice": {
            "type": "string"
          }
        }
      }
    },
    "quick_reference_voice": {
      "type": "string",
      "description": "Voice the quick-reference narration was recorded in"
    },
    "quick_reference_generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "tips_segments": {
      "type": "array",
      "description": "The spoken general media interview coaching behind the Interview tips tab - one short clip per numbered section heading and per point, each with the pause that follows it. The tips themselves are the same for every guide, so only the audio is stored here.",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "cue",
              "heading",
              "point"
            ],
            "enumColors": [
              "gray",
              "purple",
              "blue"
            ]
          },
          "text": {
            "type": "string",
            "description": "Exactly what the narrator says for this clip"
          },
          "category_label": {
            "type": "string",
            "description": "Tips section this clip belongs to, shown while it plays"
          },
          "category_index": {
            "type": "number",
            "description": "Position of the tips section this clip belongs to, for highlighting and per-section playback"
          },
          "point_index": {
            "type": "number",
            "description": "Position of this clip inside its section"
          },
          "pause_after_ms": {
            "type": "number",
            "description": "Silence left after this clip before the next one, in milliseconds"
          },
          "audio_url": {
            "type": "string"
          },
          "voice": {
            "type": "string"
          }
        }
      }
    },
    "tips_voice": {
      "type": "string",
      "description": "Voice the interview tips narration was recorded in"
    },
    "tips_generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "quick_reference_info": {
      "type": "array",
      "description": "The essential practical details shown once in the compact box on the one-page quick reference cheat sheet - where and when the donation drive is, what is needed and where to give.",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "description": "What the row is about, e.g. Donation drive"
          },
          "value": {
            "type": "string",
            "description": "The detail itself, e.g. Thursday, November 26, 1-4 PM"
          },
          "url": {
            "type": "string",
            "description": "Link the value opens, when there is one"
          }
        },
        "required": [
          "label"
        ]
      }
    },
    "quick_reference": {
      "type": "array",
      "description": "The scannable quick-reference blocks - priority messages, donations, events",
      "items": {
        "type": "object",
        "properties": {
          "heading": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "partners": {
      "type": "array",
      "description": "Partners and supporters to acknowledge, with how to acknowledge each",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "important_dates": {
      "type": "array",
      "description": "Dates the spokesperson may be asked about",
      "items": {
        "type": "object",
        "properties": {
          "when": {
            "type": "string",
            "description": "How the date reads, e.g. November 26 or Around December 5"
          },
          "event": {
            "type": "string"
          },
          "location": {
            "type": "string"
          }
        }
      }
    },
    "reminders": {
      "type": "array",
      "description": "Interview reminders - what to emphasise, what to avoid saying",
      "items": {
        "type": "string"
      }
    },
    "contacts": {
      "type": "array",
      "description": "Contact details shown at the end of the guide",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "value": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        }
      }
    },
    "assigned_to_name": {
      "type": "string",
      "description": "Staff member the guide was handed to"
    },
    "assigned_to_email": {
      "type": "string"
    },
    "published_at": {
      "type": "string",
      "format": "date-time"
    },
    "archived_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_by_name": {
      "type": "string",
      "description": "Staff member who built the guide"
    }
  },
  "required": [
    "title",
    "token"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}