{
  "name": "ProgramRegistration",
  "type": "object",
  "properties": {
    "participant_first_name": {
      "type": "string"
    },
    "participant_last_name": {
      "type": "string"
    },
    "participant_name": {
      "type": "string",
      "description": "Denormalized full name"
    },
    "participant_phone": {
      "type": "string"
    },
    "participant_email": {
      "type": "string"
    },
    "program_portal": {
      "type": "string",
      "enum": [
        "ell",
        "frn",
        "phac",
        "empoweru",
        "rc",
        "pathways",
        "other"
      ],
      "description": "Which program portal this registration is for"
    },
    "program_name": {
      "type": "string",
      "description": "Specific program/cohort name"
    },
    "registration_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending_approval",
        "approved",
        "waitlisted",
        "declined",
        "enrolled",
        "completed",
        "withdrawn"
      ],
      "default": "pending_approval",
      "description": "Registration status"
    },
    "requires_approval": {
      "type": "boolean",
      "default": false,
      "description": "Whether facilitator/manager approval is needed"
    },
    "approver_name": {
      "type": "string",
      "description": "Who needs to approve"
    },
    "approver_email": {
      "type": "string",
      "description": "Approver's email for notification"
    },
    "approval_request_sent": {
      "type": "boolean",
      "default": false
    },
    "approval_date": {
      "type": "string",
      "format": "date"
    },
    "approval_notes": {
      "type": "string"
    },
    "waitlist_position": {
      "type": "number",
      "default": 0
    },
    "eligibility_assessed": {
      "type": "boolean",
      "default": false
    },
    "eligibility_notes": {
      "type": "string"
    },
    "eligibility_status": {
      "type": "string",
      "enum": [
        "eligible",
        "conditionally_eligible",
        "not_eligible",
        "not_assessed"
      ],
      "default": "not_assessed"
    },
    "accommodation_needs": {
      "type": "string"
    },
    "parent_guardian_name": {
      "type": "string",
      "description": "Parent/guardian full name (Kids Gift Shop and child-focused programs)"
    },
    "parent_guardian_phone": {
      "type": "string",
      "description": "Parent/guardian contact number"
    },
    "parent_guardian_email": {
      "type": "string",
      "description": "Parent/guardian email"
    },
    "child_name": {
      "type": "string",
      "description": "Child's name for a Kids Gift Shop registration"
    },
    "child_age_band": {
      "type": "string",
      "enum": [
        "0-5",
        "6-16"
      ],
      "description": "Child's age band for a Kids Gift Shop registration"
    },
    "gift_count": {
      "type": "number",
      "description": "How many gifts the child is shopping for (1 or 2)"
    },
    "gift_1_gender": {
      "type": "string",
      "enum": [
        "female",
        "male"
      ],
      "description": "Who the first gift is for"
    },
    "gift_2_gender": {
      "type": "string",
      "enum": [
        "female",
        "male"
      ],
      "description": "Who the second gift is for, when the child is shopping for two"
    },
    "children": {
      "type": "array",
      "description": "Children registered under this record (legacy Kids Gift Shop records)",
      "items": {
        "type": "object",
        "properties": {
          "first_name": {
            "type": "string",
            "description": "Child's first name"
          },
          "age": {
            "type": "number",
            "description": "Child's age"
          }
        },
        "required": [
          "first_name"
        ]
      }
    },
    "time_slot": {
      "type": "string",
      "enum": [
        "10:30",
        "10:45",
        "11:00",
        "11:15",
        "11:30",
        "11:45",
        "12:00",
        "12:15",
        "12:30",
        "12:45",
        "13:00",
        "13:15",
        "13:30",
        "13:45",
        "14:00",
        "14:15",
        "14:30",
        "14:45"
      ],
      "description": "Selected Kids Gift Shop shopping slot (24-hour time)"
    },
    "checked_in": {
      "type": "boolean",
      "default": false,
      "description": "Whether the child has been signed in at the Kids Gift Shop desk on the festival day"
    },
    "checked_in_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the child was signed in \u2014 the order of sign-ins sets the name-tag sequence"
    },
    "check_in_sequence": {
      "type": "number",
      "description": "Name-tag order number, handed out in the order children are signed in"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "participant_first_name",
    "participant_last_name",
    "program_portal",
    "registration_date"
  ]
}