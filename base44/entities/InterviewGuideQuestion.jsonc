{
  "name": "InterviewGuideQuestion",
  "type": "object",
  "description": "One question inside an interview preparation guide - the question as the host will ask it, the preparation material grouped into thematic categories of talking points, the single key message to land, the short scan-ready bullets used on the one-page quick reference, and the spoken narration broken into short clips (question, category headings, individual talking points, key message) each with the pause that follows it. Questions are ordered by display_order so staff can reorder them.",
  "properties": {
    "guide_id": {
      "type": "string",
      "description": "The guide this question belongs to"
    },
    "display_order": {
      "type": "number",
      "default": 0,
      "description": "Position in the guide, lowest first"
    },
    "question": {
      "type": "string",
      "description": "The question as the host will ask it"
    },
    "categories": {
      "type": "array",
      "description": "The preparation material for this question, grouped into thematic categories. Each category has a heading that is spoken aloud and shown as a subheading, and its own individual talking points. Written and spoken versions follow this same order.",
      "items": {
        "type": "object",
        "properties": {
          "heading": {
            "type": "string",
            "description": "Thematic category heading, e.g. Our history and community"
          },
          "points": {
            "type": "array",
            "description": "The individual talking points in this category, one short statement each",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "heading"
        ]
      }
    },
    "key_message": {
      "type": "string",
      "description": "The one message to land in this answer. Paragraphs are separated by a blank line."
    },
    "quick_points": {
      "type": "array",
      "description": "The two or three short bullets shown under this question on the one-page quick reference cheat sheet. Written for scanning during a live interview: brief, factual, never repeating the key message. Phrases wrapped in double asterisks are shown in bold.",
      "items": {
        "type": "string"
      }
    },
    "checklist": {
      "type": "array",
      "description": "Important messages to tick off while practising this answer",
      "items": {
        "type": "string"
      }
    },
    "narration_segments": {
      "type": "array",
      "description": "The spoken narration, one short clip per question, category heading, talking point and key message, each with the pause that follows it so the listener has time to absorb the material.",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Stable id of this clip within the question, e.g. q, cue, h0, p1-2, keylabel, k0"
          },
          "kind": {
            "type": "string",
            "enum": [
              "question",
              "cue",
              "heading",
              "point",
              "keylabel",
              "key"
            ],
            "enumColors": [
              "blue",
              "gray",
              "purple",
              "blue",
              "yellow",
              "green"
            ],
            "description": "question = the question as asked; cue = the spoken section cue; heading = a category heading; point = one talking point; keylabel = the words Key message; key = a paragraph of the key message"
          },
          "text": {
            "type": "string",
            "description": "Exactly what the narrator says for this clip"
          },
          "category_label": {
            "type": "string",
            "description": "Category this clip belongs to, shown while it plays"
          },
          "category_index": {
            "type": "number",
            "description": "Index of the category in categories, for category playback"
          },
          "point_index": {
            "type": "number",
            "description": "Index of the talking point inside its category"
          },
          "pause_after_ms": {
            "type": "number",
            "description": "Silence left after this clip before the next one, in milliseconds"
          },
          "audio_url": {
            "type": "string",
            "description": "Stored audio file of this clip"
          },
          "voice": {
            "type": "string",
            "description": "Voice this clip was recorded in, so a voice change is noticed"
          }
        }
      }
    },
    "voice_used": {
      "type": "string",
      "description": "Voice the current narration was recorded in"
    },
    "audio_generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the narration audio was last generated"
    }
  },
  "required": [
    "guide_id",
    "question"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}