{
  "name": "CCStatementLineItem",
  "type": "object",
  "properties": {
    "statement_id": {
      "type": "string",
      "description": "Reference to the CCStatement this line item belongs to"
    },
    "line_number": {
      "type": "number",
      "description": "Line number as it appears on the statement itself (the transaction's position in the statement's numbering), set automatically when reading the statement and editable per row"
    },
    "description": {
      "type": "string",
      "description": "Line item description (transaction from the card statement)"
    },
    "amount": {
      "type": "number",
      "description": "Line item amount"
    },
    "receipt_url": {
      "type": "string",
      "description": "Uploaded receipt file URL for this line item"
    },
    "receipt_file_name": {
      "type": "string",
      "description": "Original uploaded receipt file name"
    },
    "notes": {
      "type": "string",
      "description": "Notes about this line item"
    }
  },
  "required": [
    "statement_id",
    "description",
    "amount"
  ]
}