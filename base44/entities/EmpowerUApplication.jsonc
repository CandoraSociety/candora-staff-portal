{
  "name": "EmpowerUApplication",
  "type": "object",
  "properties": {
    "cohort_id": {
      "type": "string",
      "description": "Reference to the EmpowerUCohort this application was submitted for (via the cohort's public registration link)"
    },
    "cohort_name": {
      "type": "string",
      "description": "Denormalized cohort name"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending",
      "description": "pending = submitted via the public link, awaiting staff approval; approved = participant profile built and added to the cohort (synced to the central database); rejected = declined"
    },
    "application_date": {
      "type": "string",
      "format": "date",
      "description": "Today's date entered by the applicant"
    },
    "consent_agreed": {
      "type": "boolean",
      "default": false,
      "description": "Applicant read and accepted the Release of Information disclosure (FOIP / HIA)"
    },
    "first_name": {
      "type": "string",
      "description": "First name (as shown in ID)"
    },
    "last_name": {
      "type": "string",
      "description": "Last name (as shown in ID)"
    },
    "date_of_birth": {
      "type": "string",
      "format": "date"
    },
    "gender": {
      "type": "string",
      "enum": [
        "female",
        "male",
        "other"
      ]
    },
    "marital_status": {
      "type": "string",
      "enum": [
        "married",
        "common_law",
        "divorced",
        "separated",
        "single",
        "widowed",
        "other"
      ]
    },
    "self_identification": {
      "type": "string",
      "enum": [
        "indigenous",
        "immigrant",
        "person_with_disabilities",
        "na"
      ],
      "description": "I identify myself as: Indigenous / Immigrant / Person with disabilities / N/A"
    },
    "citizenship": {
      "type": "string",
      "enum": [
        "canadian_citizen",
        "permanent_resident",
        "temporary_resident",
        "refugee",
        "first_nations_metis_inuit"
      ]
    },
    "arrival_canada": {
      "type": "string",
      "description": "If immigrant \u2014 arrival in Canada (mm/yy or N/A)"
    },
    "country_of_origin": {
      "type": "string"
    },
    "family_language": {
      "type": "string",
      "enum": [
        "english",
        "french",
        "indigenous_language",
        "other"
      ],
      "description": "Language the family speaks at home"
    },
    "high_school_completed": {
      "type": "string",
      "enum": [
        "yes",
        "no",
        "prefer_not_to_answer"
      ]
    },
    "address": {
      "type": "string",
      "description": "Full address including unit/house number, street, city and postal code"
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "emergency_contact": {
      "type": "string",
      "description": "Emergency contact name and number"
    },
    "referral_organization": {
      "type": "string",
      "description": "Referring organization (if referred by another agency)"
    },
    "photo_consent": {
      "type": "string",
      "enum": [
        "consent",
        "refuse"
      ],
      "description": "Consent to photos taken at CANDORA activities being displayed publicly"
    },
    "learned_about_candora": {
      "type": "string",
      "enum": [
        "website",
        "friend_neighbour",
        "poster_mall",
        "candora_employment_program",
        "referred_by_agency"
      ]
    },
    "participant_id": {
      "type": "string",
      "description": "Reference to the EmpowerUParticipant created when the application was approved"
    },
    "reviewed_by_name": {
      "type": "string",
      "description": "Staff member who approved/rejected the application"
    },
    "reviewed_date": {
      "type": "string",
      "format": "date"
    },
    "review_notes": {
      "type": "string"
    }
  },
  "required": [
    "cohort_id",
    "first_name",
    "last_name"
  ]
}