{
  "name": "Workshop",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Workshop title"
    },
    "description": {
      "type": "string",
      "description": "What the workshop covers"
    },
    "category": {
      "type": "string",
      "enum": [
        "none",
        "job_search_workshop",
        "resume_writing_workshop",
        "interview_skills_workshop",
        "workplace_readiness_workshop",
        "financial_literacy_workshop",
        "digital_literacy_workshop"
      ],
      "default": "none",
      "description": "Links this workshop to a client's action-plan workshop item so it can be highlighted in the client file and auto-completed on attendance."
    },
    "facilitator_name": {
      "type": "string",
      "description": "Facilitator full name"
    },
    "facilitator_email": {
      "type": "string",
      "description": "Facilitator email (optional \u2014 usually a Pathways staff member)"
    },
    "location": {
      "type": "string",
      "description": "Room / address where the workshop is held"
    },
    "capacity": {
      "type": "number",
      "default": 15,
      "description": "Maximum attendees per session"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "First / base session date"
    },
    "start_time": {
      "type": "string",
      "description": "Start time (HH:MM 24h)"
    },
    "end_time": {
      "type": "string",
      "description": "End time (HH:MM 24h)"
    },
    "recurrence_pattern": {
      "type": "string",
      "enum": [
        "none",
        "weekly",
        "biweekly",
        "monthly"
      ],
      "default": "none",
      "description": "How the workshop recurs from the base date"
    },
    "recurrence_end_date": {
      "type": "string",
      "format": "date",
      "description": "Last recurrence date (blank for a one-off session)"
    },
    "status": {
      "type": "string",
      "enum": [
        "scheduled",
        "completed",
        "cancelled"
      ],
      "default": "scheduled"
    },
    "color": {
      "type": "string",
      "default": "#2563eb",
      "description": "Hex color used for the schedule block"
    },
    "created_by_name": {
      "type": "string"
    },
    "created_by_email": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "date"
  ]
}