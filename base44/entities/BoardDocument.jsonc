{
  "name": "BoardDocument",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "document_type": {
      "type": "string",
      "enum": [
        "minutes",
        "agenda",
        "financial_report",
        "ed_report",
        "committee_report",
        "policy",
        "bylaw",
        "strategic_plan",
        "training",
        "corporate_doc",
        "other"
      ],
      "default": "other"
    },
    "meeting_id": {
      "type": "string",
      "description": "Associated meeting (optional)"
    },
    "file_url": {
      "type": "string"
    },
    "file_name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "package_files": {
      "type": "array",
      "description": "Documents bundled into this meeting package zip (agenda, minutes, financials, reports) \u2014 each entry links to that document on its own so it can be opened without unzipping",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "description": "Name shown on the meeting card"
          },
          "file_name": {
            "type": "string",
            "description": "File name inside the zip"
          },
          "file_url": {
            "type": "string"
          }
        }
      }
    },
    "is_public_to_board": {
      "type": "boolean",
      "default": true
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "uploaded_by": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "document_type"
  ]
}