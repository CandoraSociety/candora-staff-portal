{
  "name": "RCClient",
  "type": "object",
  "properties": {
    "first_name": {
      "type": "string",
      "description": "Client's first name"
    },
    "last_name": {
      "type": "string",
      "description": "Client's last name"
    },
    "date_of_birth": {
      "type": "string",
      "format": "date",
      "description": "Date of birth"
    },
    "gender": {
      "type": "string",
      "enum": [
        "male",
        "female"
      ],
      "description": "Gender"
    },
    "marital_status": {
      "type": "string",
      "enum": [
        "single",
        "married",
        "common_law",
        "separated",
        "divorced",
        "widowed"
      ],
      "description": "Marital status"
    },
    "spouse_client_id": {
      "type": "string",
      "description": "Linked RCClient ID of the client's spouse, when the spouse is an existing client"
    },
    "spouse_name": {
      "type": "string",
      "description": "Spouse's full name (denormalized from the linked client profile)"
    },
    "dependants_count": {
      "type": "number",
      "description": "Number of dependants"
    },
    "dependants_detail": {
      "type": "string",
      "description": "Dependant details (e.g. 2 children ages 3 and 7, elderly mother)"
    },
    "phone": {
      "type": "string",
      "description": "Phone number"
    },
    "email": {
      "type": "string",
      "description": "Email address"
    },
    "address": {
      "type": "string",
      "description": "Street address"
    },
    "city": {
      "type": "string"
    },
    "postal_code": {
      "type": "string"
    },
    "preferred_language": {
      "type": "string",
      "description": "Primary language"
    },
    "additional_languages": {
      "type": "string",
      "description": "Additional languages spoken (comma-separated)"
    },
    "english_proficiency": {
      "type": "string",
      "enum": [
        "strong",
        "acceptable",
        "low"
      ],
      "description": "Basic English language proficiency evaluation"
    },
    "english_proficiency_notes": {
      "type": "string",
      "description": "Notes supporting the English proficiency evaluation"
    },
    "indigenous_first_nations": {
      "type": "boolean",
      "description": "Demographics: client identifies as Indigenous / First Nations"
    },
    "newcomer": {
      "type": "boolean",
      "description": "Demographics: client identifies as a newcomer to Canada"
    },
    "senior": {
      "type": "boolean",
      "description": "Demographics: client identifies as a senior"
    },
    "youth_under_25": {
      "type": "boolean",
      "description": "Demographics: client is a youth under 25"
    },
    "emergency_contact_name": {
      "type": "string"
    },
    "emergency_contact_phone": {
      "type": "string"
    },
    "funder_categories": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "phac_caregiver_capacity",
          "pathways",
          "frn",
          "other"
        ]
      },
      "description": "Funding sources/categories. phac_caregiver_capacity = caregiver support for families/parents with children 0-6 (PHAC-funded, isolatable for reporting)"
    },
    "service_category": {
      "type": "string",
      "enum": [
        "intensive_services",
        "caregiver_capacity_0_5",
        "general"
      ],
      "description": "Service category assigned at intake (mandatory). Intensive Services, Caregiver Capacity 0-5, or General."
    },
    "has_children_0_6": {
      "type": "boolean",
      "description": "Has children aged 0-6 (PHAC caregiver capacity field)"
    },
    "children_count_0_6": {
      "type": "number",
      "description": "Number of children aged 0-6"
    },
    "children_ages_detail": {
      "type": "string",
      "description": "Details about children's ages (PHAC field)"
    },
    "assigned_worker": {
      "type": "string",
      "description": "Assigned resource worker"
    },
    "case_status": {
      "type": "string",
      "enum": [
        "intake",
        "active",
        "monitoring",
        "closed",
        "waitlisted"
      ],
      "default": "intake",
      "description": "Current case management status"
    },
    "intake_date": {
      "type": "string",
      "format": "date",
      "description": "Date of intake"
    },
    "reason_for_accessing": {
      "type": "string",
      "enum": [
        "program_registration",
        "emergency_food",
        "emergency_clothing",
        "bus_tickets",
        "housing_concerns",
        "financial_assistance",
        "mental_health_wellbeing",
        "family_parenting_support",
        "advocacy_navigation",
        "documentation_id",
        "employment_income",
        "settlement_immigration",
        "health_medical",
        "crisis_safety",
        "other"
      ],
      "description": "Reason the client is accessing services / reason for the visit. Grab-and-go visits use the basic options; Drop-In Casework and Scheduled Visits use the more complex casework options (housing, financial, mental health, family support, advocacy, etc.)."
    },
    "reason_for_accessing_other": {
      "type": "string",
      "description": "If reason is 'other', specify"
    },
    "identified_needs": {
      "type": "string",
      "description": "Needs identified during intake"
    },
    "presenting_needs": {
      "type": "string",
      "description": "Legacy free-text needs field (pre-'Reason For Accessing Services'). Retained for existing records."
    },
    "referral_source": {
      "type": "string",
      "description": "How they came to the resource centre"
    },
    "notes": {
      "type": "string",
      "description": "General case notes"
    },
    "visit_count": {
      "type": "number",
      "default": 0,
      "description": "Total client visits logged (grab-and-go, drop-in casework and scheduled visits)"
    },
    "program_participations": {
      "type": "array",
      "description": "Program-participation indicators auto-maintained by each program's sync into the Candora Central Database. One entry per program a person participates in. Managed by base44/shared/centralDbSync.ts \u2014 do not edit manually.",
      "items": {
        "type": "object",
        "properties": {
          "program": {
            "type": "string",
            "description": "Program key (pathways, empoweru, frn, phac, community, ell, digilit)"
          },
          "linked_id": {
            "type": "string",
            "description": "ID of the participant record in the source program"
          },
          "indicator": {
            "type": "string",
            "description": "Human-readable participation status (e.g. 'Enrolled in the Pathways program. Anticipated completion: ...')"
          },
          "updated_date": {
            "type": "string",
            "description": "ISO timestamp of the last sync"
          },
          "details": {
            "type": "object",
            "description": "Structured program details (currently Pathways): start date, stream, status, completion outcome, and completion/cancelled date",
            "properties": {
              "start_date": {
                "type": "string",
                "format": "date",
                "description": "Program start date (YYYY-MM-DD)"
              },
              "stream": {
                "type": "string",
                "description": "Program stream (e.g. pathways = WD, direct_to_employment = DEA)"
              },
              "status": {
                "type": "string",
                "description": "Program status (in_progress, complete, incomplete, cancelled)"
              },
              "outcome": {
                "type": "string",
                "description": "Completion outcome code (E-RF, E-UF, SE, ...)"
              },
              "end_date": {
                "type": "string",
                "format": "date",
                "description": "Completion or cancelled date (YYYY-MM-DD)"
              }
            }
          }
        }
      }
    }
  },
  "required": [
    "first_name",
    "last_name"
  ]
}