{
  "name": "CommunitySession",
  "type": "object",
  "properties": {
    "program_id": {
      "type": "string",
      "description": "Reference to CommunityProgram"
    },
    "program_name": {
      "type": "string",
      "description": "Denormalized program name"
    },
    "title": {
      "type": "string",
      "description": "Session title/topic"
    },
    "session_date": {
      "type": "string",
      "format": "date",
      "description": "Date of the session"
    },
    "start_time": {
      "type": "string",
      "description": "Start time (HH:MM)"
    },
    "end_time": {
      "type": "string",
      "description": "End time (HH:MM)"
    },
    "location": {
      "type": "string"
    },
    "room": {
      "type": "string",
      "enum": [
        "large_classroom",
        "small_classroom",
        "employment_classroom",
        "arc",
        "echo_valley",
        "virtual",
        "other"
      ],
      "description": "Assigned room (Large Classroom, Small Classroom, Employment Classroom, ARC, Echo Valley, Virtual, or Other space)"
    },
    "recurrence_pattern": {
      "type": "string",
      "enum": [
        "none",
        "weekly",
        "biweekly",
        "monthly"
      ],
      "default": "none",
      "description": "How the session recurs from the base date (expanded on the Central Registration calendar)"
    },
    "recurrence_end_date": {
      "type": "string",
      "format": "date",
      "description": "Last recurrence date (blank for a one-off session)"
    },
    "facilitator_name": {
      "type": "string",
      "description": "Volunteer/staff facilitating"
    },
    "facilitator_email": {
      "type": "string"
    },
    "registered_participant_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs of registered CommunityParticipants"
    },
    "attended_participant_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs of participants who attended"
    },
    "plan": {
      "type": "string",
      "description": "Session plan \u2014 projects, activities, materials planned for this session"
    },
    "documents": {
      "type": "array",
      "description": "Uploaded photos and documents (patterns, instructions) attached to this session",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "file_name": {
            "type": "string",
            "description": "Display name of the file"
          },
          "file_url": {
            "type": "string",
            "description": "Uploaded file URL"
          },
          "uploaded_date": {
            "type": "string",
            "format": "date"
          },
          "uploaded_by_name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "file_url"
        ]
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "scheduled",
        "completed",
        "cancelled"
      ],
      "default": "scheduled",
      "description": "Session status"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "program_id",
    "session_date"
  ]
}