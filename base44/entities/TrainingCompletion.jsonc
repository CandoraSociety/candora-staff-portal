{
  "name": "TrainingCompletion",
  "type": "object",
  "properties": {
    "employee_id": {
      "type": "string",
      "description": "Employee record this training completion belongs to"
    },
    "employee_name": {
      "type": "string",
      "description": "Staff member's display name (denormalized for the HR profile)"
    },
    "employee_email": {
      "type": "string",
      "description": "Staff member's work email \u2014 used to match the record to an employee profile"
    },
    "plan_id": {
      "type": "string",
      "description": "TrainingDayPlan this completion is for"
    },
    "plan_title": {
      "type": "string",
      "description": "Training plan title (denormalized so the profile reads without loading the plan)"
    },
    "plan_date": {
      "type": "string",
      "format": "date",
      "description": "Day the training ran"
    },
    "status": {
      "type": "string",
      "enum": [
        "not_started",
        "in_progress",
        "completed"
      ],
      "default": "in_progress",
      "description": "Completion status of the training plan for this staff member"
    },
    "completion_date": {
      "type": "string",
      "format": "date",
      "description": "Date the training was completed"
    },
    "notes": {
      "type": "string",
      "description": "Optional note \u2014 what is outstanding, or what was signed off"
    },
    "recorded_by_name": {
      "type": "string",
      "description": "Facilitator who recorded this completion"
    }
  },
  "required": [
    "employee_email",
    "plan_id",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}