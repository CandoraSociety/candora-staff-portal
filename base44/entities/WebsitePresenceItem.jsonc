{
  "name": "WebsitePresenceItem",
  "type": "object",
  "description": "The state of one online-presence task for the Candora website \u2014 a listing to claim, a profile to keep consistent, a review habit, a piece of technical health. The tasks themselves come from the checklist built into Website Studio; this record remembers which ones are done and what was learned, so the work survives between visits.",
  "properties": {
    "item_key": {
      "type": "string",
      "description": "Stable key of the checklist task this record belongs to"
    },
    "label": {
      "type": "string",
      "description": "The task as it read when it was last saved"
    },
    "category": {
      "type": "string",
      "enum": [
        "listings",
        "reviews",
        "social",
        "ai_search",
        "technical",
        "content",
        "measurement"
      ],
      "enumColors": [
        "blue",
        "yellow",
        "purple",
        "green",
        "gray",
        "pink",
        "blue"
      ],
      "description": "Which part of online presence the task belongs to"
    },
    "status": {
      "type": "string",
      "enum": [
        "todo",
        "in_progress",
        "done",
        "not_applicable"
      ],
      "enumColors": [
        "gray",
        "yellow",
        "green",
        "purple"
      ],
      "default": "todo",
      "description": "Where the task stands"
    },
    "notes": {
      "type": "string",
      "description": "What was found or done \u2014 logins, listing links, who was contacted"
    },
    "link_url": {
      "type": "string",
      "description": "Where the task is carried out, e.g. the listing or console page"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the task was marked done"
    },
    "updated_by_name": {
      "type": "string",
      "description": "Staff member who last changed it"
    }
  },
  "required": [
    "item_key"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}