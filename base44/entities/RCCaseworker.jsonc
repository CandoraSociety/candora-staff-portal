{
  "name": "RCCaseworker",
  "type": "object",
  "properties": {
    "staff_email": {
      "type": "string",
      "description": "Staff user email \u2014 visits assigned to this caseworker appear on their personal Worker Dashboard"
    },
    "display_name": {
      "type": "string",
      "description": "Caseworker name as it appears on client records and appointments"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this caseworker is currently active"
    },
    "intensive_access": {
      "type": "boolean",
      "default": false,
      "description": "Whether this caseworker has permission for Intensive Services casework (full FRN workflow access). Without it, they only see intensive client names and status in the Case Management master list."
    }
  },
  "required": [
    "staff_email"
  ]
}