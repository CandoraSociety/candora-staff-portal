{
  "name": "DashboardNotification",
  "type": "object",
  "properties": {
    "recipient_email": {
      "type": "string",
      "description": "Email of the staff user the notification is for \u2014 appears on their main Dashboard"
    },
    "recipient_name": {
      "type": "string",
      "description": "Display name of the recipient (denormalized for display)"
    },
    "kind": {
      "type": "string",
      "enum": [
        "reimbursement_paid",
        "cc_receipts_paid",
        "ed_briefing",
        "other"
      ],
      "default": "other",
      "description": "Type of notification (reimbursement marked paid, MasterCard receipt submission processed, scheduled ED briefing, other)"
    },
    "related_form_id": {
      "type": "string",
      "description": "ID of the reimbursement/MasterCard form this notification is about \u2014 lets Finance dismiss it if the payment is reversed"
    },
    "title": {
      "type": "string",
      "description": "Short notification headline"
    },
    "message": {
      "type": "string",
      "description": "Notification body text shown on the Dashboard"
    },
    "items": {
      "type": "array",
      "description": "Interactive ED-briefing items \u2014 checklist rows, decision cards and assistant offers rendered under the briefing message; actions on them are executed by the handleEdBriefingAction function",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Stable id of this item within the notification"
          },
          "kind": {
            "type": "string",
            "enum": [
              "checklist",
              "decision",
              "offer"
            ],
            "description": "checklist = tappable row that completes a real record; decision = needs-your-call card with action buttons; offer = something the assistant can do for the recipient"
          },
          "text": {
            "type": "string",
            "description": "Item headline shown to the recipient"
          },
          "context": {
            "type": "string",
            "description": "Supporting facts shown under the headline (decision cards)"
          },
          "entity_type": {
            "type": "string",
            "description": "Entity the action writes to (EDTask, PersonalOrganizer, PurchaseRequest)"
          },
          "entity_id": {
            "type": "string",
            "description": "Record id the action writes to"
          },
          "action": {
            "type": "string",
            "description": "Checklist action key (complete_ed_task, complete_todo)"
          },
          "task_index": {
            "type": "number",
            "description": "Index of the to-do inside the organizer record's tasks array (complete_todo)"
          },
          "offer_type": {
            "type": "string",
            "description": "Offer key (create_task, metrics_summary)"
          },
          "actions": {
            "type": "array",
            "description": "Decision card buttons",
            "items": {
              "type": "object",
              "properties": {
                "key": {
                  "type": "string",
                  "description": "Action key sent to handleEdBriefingAction"
                },
                "label": {
                  "type": "string",
                  "description": "Button label shown to the recipient"
                }
              }
            }
          },
          "payload": {
            "type": "object",
            "description": "Offer payload (e.g. task fields to create, metrics snapshot to summarize)"
          },
          "link": {
            "type": "string",
            "description": "Optional in-app path for full action in the portal"
          },
          "status": {
            "type": "string",
            "enum": [
              "open",
              "done"
            ],
            "default": "open",
            "description": "Whether the recipient already acted on this item"
          },
          "result": {
            "type": "string",
            "description": "Outcome text shown after the action runs (e.g. the compiled snapshot)"
          },
          "action_taken": {
            "type": "string",
            "description": "Which action key was used"
          },
          "action_at": {
            "type": "string",
            "description": "When the action was taken"
          }
        }
      }
    },
    "link": {
      "type": "string",
      "description": "Optional in-app path to open from the notification (e.g. /reimbursement-requests)"
    },
    "is_read": {
      "type": "boolean",
      "default": false,
      "description": "Whether the recipient has dismissed the notification from their Dashboard"
    }
  },
  "required": [
    "recipient_email",
    "title",
    "message"
  ]
}