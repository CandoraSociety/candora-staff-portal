{
  "name": "SavedESignature",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Reference to the User this saved signature belongs to"
    },
    "name": {
      "type": "string",
      "description": "Display name for this saved signature (e.g. 'Primary', 'Initials')"
    },
    "signature_type": {
      "type": "string",
      "enum": [
        "typed",
        "drawn",
        "upload"
      ],
      "description": "How the signature was created: typed text with styling, hand-drawn, or an uploaded image"
    },
    "typed_text": {
      "type": "string",
      "description": "The text rendered for typed signatures"
    },
    "font_family": {
      "type": "string",
      "description": "Font family used for typed signatures"
    },
    "font_color": {
      "type": "string",
      "description": "Colour used for typed signatures (hex)"
    },
    "bold": {
      "type": "boolean",
      "default": false,
      "description": "Bold effect for typed signatures"
    },
    "italic": {
      "type": "boolean",
      "default": false,
      "description": "Italic effect for typed signatures"
    },
    "shadow": {
      "type": "boolean",
      "default": false,
      "description": "Drop-shadow effect for typed signatures"
    },
    "underline": {
      "type": "boolean",
      "default": false,
      "description": "Underline effect for typed signatures"
    },
    "glow": {
      "type": "boolean",
      "default": false,
      "description": "Glow effect for typed signatures"
    },
    "outline": {
      "type": "boolean",
      "default": false,
      "description": "Hollow-outline effect for typed signatures"
    },
    "letter_spacing": {
      "type": "number",
      "default": 0,
      "description": "Letter spacing in px for typed signatures"
    },
    "signature_url": {
      "type": "string",
      "description": "Image file URL for drawn/uploaded signatures"
    }
  },
  "required": [
    "user_id",
    "name",
    "signature_type"
  ]
}