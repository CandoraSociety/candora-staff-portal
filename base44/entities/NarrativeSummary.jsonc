{
  "name": "NarrativeSummary",
  "type": "object",
  "properties": {
    "report_month": {
      "type": "string",
      "description": "YYYY-MM \u2014 the reporting month this narrative summary belongs to"
    },
    "category": {
      "type": "string",
      "enum": [
        "client_issues_trends",
        "communication_collaboration_scss",
        "employer_engagement_activities",
        "labour_market_observations",
        "program_marketing_activities",
        "program_delivery_activities",
        "risk_management_strategies",
        "staffing_updates",
        "other"
      ],
      "description": "Narrative category \u2014 mirrors the CRT Narrative Report sheet's dropdown list exactly."
    },
    "summary": {
      "type": "string",
      "description": "Free-text narrative summary for this category/month"
    },
    "submitted_by": {
      "type": "string",
      "description": "Email of the staff member who submitted the summary"
    },
    "submitted_by_name": {
      "type": "string",
      "description": "Name of the staff member who submitted the summary"
    },
    "submitted_date": {
      "type": "string",
      "format": "date"
    },
    "include_in_crt": {
      "type": "boolean",
      "default": false,
      "description": "When checked, this summary is included in the next push to the CRT Narrative Report sheet for its month."
    },
    "display_order": {
      "type": "number",
      "description": "Position of this summary among the checked summaries for its month \u2014 lowest is written to the CRT Narrative Report sheet first. Set by the up/down arrows in Staff Monthly Reports."
    },
    "crt_month": {
      "type": "string",
      "description": "YYYY-MM \u2014 the CRT workbook month this summary is pushed into. Blank means its own report_month's CRT. Set when a month's summaries are carried into a later month's CRT (for example July summaries added to August's CRT); the row keeps its own Reporting Period dates in the sheet."
    }
  },
  "required": [
    "report_month",
    "category",
    "summary",
    "submitted_by"
  ]
}