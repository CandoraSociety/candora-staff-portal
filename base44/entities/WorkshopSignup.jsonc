{
  "name": "WorkshopSignup",
  "type": "object",
  "properties": {
    "workshop_id": {
      "type": "string",
      "description": "Linked Workshop ID"
    },
    "session_date": {
      "type": "string",
      "format": "date",
      "description": "Which occurrence date the signup is for (workshops can recur)"
    },
    "client_id": {
      "type": "string",
      "description": "Linked Client ID (blank for non-client attendees)"
    },
    "attendee_name": {
      "type": "string",
      "description": "Attendee full name"
    },
    "attendee_email": {
      "type": "string",
      "description": "Attendee email"
    },
    "signup_date": {
      "type": "string",
      "format": "date",
      "description": "Date the signup was created (auto-set)"
    },
    "status": {
      "type": "string",
      "enum": [
        "registered",
        "attended",
        "cancelled",
        "no_show"
      ],
      "default": "registered",
      "description": "Final attendance outcome. 'attended' is recorded by the facilitator's Complete-Session action (not by a single checkmark)."
    },
    "present": {
      "type": "boolean",
      "default": false,
      "description": "Attendance-at-arrival marker. Facilitator checks this when the client arrives (taking attendance); the Complete-Session action then records those checked as 'attended'."
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "workshop_id",
    "session_date",
    "attendee_name"
  ]
}