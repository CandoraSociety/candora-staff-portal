{
  "name": "KioskPrompt",
  "type": "object",
  "description": "Something the reception portal has put on a customer tablet: a donation ask, an order to take, a sign-in form for someone accessing services in the resource centre, or a message. The tablet shows the newest open prompt and reports back what the customer entered.",
  "properties": {
    "station_id": {
      "type": "string",
      "description": "KioskStation this prompt was sent to"
    },
    "station_name": {
      "type": "string",
      "description": "Station name (denormalized so lists read without a lookup)"
    },
    "kind": {
      "type": "string",
      "enum": [
        "message",
        "donation",
        "purchase",
        "self_registration"
      ],
      "default": "message",
      "description": "What the customer sees on the tablet"
    },
    "title": {
      "type": "string",
      "description": "Headline shown on the tablet"
    },
    "message": {
      "type": "string",
      "description": "Supporting line shown under the headline"
    },
    "amounts": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "description": "Suggested donation amounts the customer can tap"
    },
    "campaign_name": {
      "type": "string",
      "description": "Campaign or appeal the gift is for"
    },
    "items": {
      "type": "array",
      "description": "Things the customer can choose from on a purchase prompt",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "price": {
            "type": "number"
          }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "sent",
        "opened",
        "submitted",
        "dismissed"
      ],
      "default": "sent",
      "description": "sent = waiting on the tablet, opened = being read, submitted = customer finished, dismissed = cleared by staff"
    },
    "response_amount": {
      "type": "number",
      "description": "Donation amount the customer chose"
    },
    "response_recurring": {
      "type": "boolean",
      "default": false,
      "description": "Whether the customer chose to repeat this gift every month"
    },
    "response_total": {
      "type": "number",
      "description": "Order total for a purchase prompt"
    },
    "response_items": {
      "type": "array",
      "description": "What the customer ordered",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "price": {
            "type": "number"
          },
          "quantity": {
            "type": "number"
          }
        }
      }
    },
    "response_name": {
      "type": "string"
    },
    "response_email": {
      "type": "string"
    },
    "response_phone": {
      "type": "string"
    },
    "response_notes": {
      "type": "string"
    },
    "response_details": {
      "type": "object",
      "description": "Everything the person typed into the tablet's client information form \u2014 the same fields reception enters when registering someone. Reception reviews and verifies these before the client file is added to the Central Database.",
      "properties": {
        "first_name": {
          "type": "string"
        },
        "last_name": {
          "type": "string"
        },
        "date_of_birth": {
          "type": "string"
        },
        "gender": {
          "type": "string"
        },
        "marital_status": {
          "type": "string"
        },
        "phone": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "address": {
          "type": "string"
        },
        "city": {
          "type": "string"
        },
        "postal_code": {
          "type": "string"
        },
        "preferred_language": {
          "type": "string"
        },
        "additional_languages": {
          "type": "string"
        },
        "dependants_count": {
          "type": "number"
        },
        "dependants_detail": {
          "type": "string"
        },
        "indigenous_first_nations": {
          "type": "boolean"
        },
        "newcomer": {
          "type": "boolean"
        },
        "senior": {
          "type": "boolean"
        },
        "youth_under_25": {
          "type": "boolean"
        },
        "english_proficiency": {
          "type": "string"
        },
        "english_proficiency_notes": {
          "type": "string"
        },
        "emergency_contact_name": {
          "type": "string"
        },
        "emergency_contact_phone": {
          "type": "string"
        },
        "reason_for_accessing": {
          "type": "string"
        },
        "reason_for_accessing_other": {
          "type": "string"
        },
        "identified_needs": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "rc_client_id": {
      "type": "string",
      "description": "Central Database client file created (or matched) from a sign-in at the tablet, set once reception has verified the details, so reception can open the file straight from the prompt"
    },
    "sent_by_name": {
      "type": "string",
      "description": "Staff member who sent the prompt"
    },
    "viewed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the tablet first displayed it"
    },
    "responded_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the customer finished"
    }
  },
  "required": [
    "station_id",
    "kind"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}