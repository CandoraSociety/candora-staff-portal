{
  "name": "Invoice",
  "type": "object",
  "properties": {
    "invoice_number": {
      "type": "string"
    },
    "billing_month": {
      "type": "string",
      "description": "YYYY-MM \u2014 the first month this invoice covers"
    },
    "billing_month_end": {
      "type": "string",
      "description": "YYYY-MM \u2014 the last month this invoice covers (inclusive). When blank or equal to billing_month, the invoice covers a single month. When set to a later month, the invoice represents the cumulative range (the CRT end-month row holds the running totals) and is labeled with the full range."
    },
    "config_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "finalized",
        "submitted"
      ],
      "default": "draft",
      "description": "draft = open, re-reads live Invoice Tracker data; finalized = closed off, frozen snapshot; submitted = sent to funder"
    },
    "base_amount": {
      "type": "number"
    },
    "header_info": {
      "type": "array",
      "description": "Snapshot of CRT Client Data A2:B6 (rows 2\u20136) captured at close-off \u2014 the org/contract header shown on the invoice.",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "value": {
            "type": "string"
          }
        }
      }
    },
    "line_items": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "subtotal_deliverables": {
      "type": "number"
    },
    "subtotal_direct_costs": {
      "type": "number"
    },
    "total_amount": {
      "type": "number"
    },
    "notes": {
      "type": "string"
    },
    "adjustment_notes": {
      "type": "array",
      "description": "Manual notes attached directly to this invoice, shown in the invoice's Adjustment Notes section. Added/edited from the Invoices tab's Add/Edit Note dialog.",
      "items": {
        "type": "object",
        "properties": {
          "cell_letter": {
            "type": "string"
          },
          "cell_label": {
            "type": "string"
          },
          "old_value": {
            "type": "string"
          },
          "new_value": {
            "type": "string"
          },
          "client_id": {
            "type": "string"
          },
          "client_name": {
            "type": "string"
          },
          "comment": {
            "type": "string"
          },
          "created_by_name": {
            "type": "string"
          },
          "created_date": {
            "type": "string",
            "format": "date"
          },
          "billing_month": {
            "type": "string"
          }
        }
      }
    },
    "generated_by": {
      "type": "string"
    },
    "finalized_date": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "billing_month"
  ]
}