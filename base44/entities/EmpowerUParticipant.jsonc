{
  "name": "EmpowerUParticipant",
  "type": "object",
  "properties": {
    "first_name": {
      "type": "string",
      "description": "Participant's first name"
    },
    "last_name": {
      "type": "string",
      "description": "Participant's last name"
    },
    "date_of_birth": {
      "type": "string",
      "format": "date"
    },
    "gender": {
      "type": "string",
      "enum": [
        "female",
        "male",
        "other"
      ]
    },
    "marital_status": {
      "type": "string",
      "enum": [
        "married",
        "common_law",
        "divorced",
        "separated",
        "single",
        "widowed",
        "other"
      ]
    },
    "self_identification": {
      "type": "string",
      "enum": [
        "indigenous",
        "immigrant",
        "person_with_disabilities",
        "na"
      ],
      "description": "Identifies as: Indigenous / Immigrant / Person with disabilities / N/A"
    },
    "citizenship": {
      "type": "string",
      "enum": [
        "canadian_citizen",
        "permanent_resident",
        "temporary_resident",
        "refugee",
        "first_nations_metis_inuit"
      ]
    },
    "arrival_canada": {
      "type": "string",
      "description": "If immigrant \u2014 arrival in Canada (mm/yy or N/A)"
    },
    "country_of_origin": {
      "type": "string"
    },
    "family_language": {
      "type": "string",
      "enum": [
        "english",
        "french",
        "indigenous_language",
        "other"
      ],
      "description": "Language the family speaks at home"
    },
    "high_school_completed": {
      "type": "string",
      "enum": [
        "yes",
        "no",
        "prefer_not_to_answer"
      ]
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "postal_code": {
      "type": "string"
    },
    "preferred_language": {
      "type": "string"
    },
    "emergency_contact": {
      "type": "string",
      "description": "Emergency contact name and number (from application form)"
    },
    "emergency_contact_name": {
      "type": "string"
    },
    "emergency_contact_phone": {
      "type": "string"
    },
    "referral_organization": {
      "type": "string",
      "description": "Referring organization (if referred by another agency)"
    },
    "photo_consent": {
      "type": "string",
      "enum": [
        "consent",
        "refuse"
      ],
      "description": "Consent to photos taken at CANDORA activities being displayed publicly"
    },
    "learned_about_candora": {
      "type": "string",
      "enum": [
        "website",
        "friend_neighbour",
        "poster_mall",
        "candora_employment_program",
        "referred_by_agency"
      ]
    },
    "application_id": {
      "type": "string",
      "description": "Reference to the EmpowerUApplication this profile was built from (if registered via the public form)"
    },
    "referral_source": {
      "type": "string",
      "description": "How they heard about EmpowerU"
    },
    "linked_rc_client_id": {
      "type": "string",
      "description": "Central Database (RCClient) record this participant is linked to \u2014 set when staff pick an existing client file at registration; the central DB sync uses it instead of auto-matching"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "first_name",
    "last_name"
  ]
}