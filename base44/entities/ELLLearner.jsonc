{
  "name": "ELLLearner",
  "type": "object",
  "properties": {
    "first_name": {
      "type": "string",
      "description": "Learner's first name"
    },
    "last_name": {
      "type": "string",
      "description": "Learner's last name"
    },
    "date_of_birth": {
      "type": "string",
      "format": "date",
      "description": "Date of birth"
    },
    "phone": {
      "type": "string",
      "description": "Phone number"
    },
    "email": {
      "type": "string",
      "description": "Email address"
    },
    "country_of_origin": {
      "type": "string",
      "description": "Country the learner is from"
    },
    "first_language": {
      "type": "string",
      "description": "Learner's native/first language"
    },
    "other_languages": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Other languages spoken"
    },
    "clb_level": {
      "type": "string",
      "enum": [
        "clb_1",
        "clb_2",
        "clb_3",
        "clb_4",
        "clb_5",
        "clb_6",
        "clb_7",
        "clb_8",
        "clb_9",
        "clb_10",
        "clb_11",
        "clb_12",
        "not_assessed"
      ],
      "default": "not_assessed",
      "description": "Current Canadian Language Benchmark level"
    },
    "enrollment_status": {
      "type": "string",
      "enum": [
        "prospective",
        "waitlisted",
        "enrolled",
        "active",
        "completed",
        "withdrawn"
      ],
      "default": "prospective",
      "description": "Enrollment status in the ELL program"
    },
    "intake_date": {
      "type": "string",
      "format": "date",
      "description": "Date of intake/registration"
    },
    "assigned_class_id": {
      "type": "string",
      "description": "Reference to ELLClass the learner is assigned to"
    },
    "assigned_class_name": {
      "type": "string",
      "description": "Name of assigned class (denormalized for display)"
    },
    "interested_course_id": {
      "type": "string",
      "description": "Reference to the ELLClass (course) the learner registered for / is interested in"
    },
    "interested_course_name": {
      "type": "string",
      "description": "Name of the course the learner is interested in (denormalized for display)"
    },
    "waitlist_date": {
      "type": "string",
      "format": "date",
      "description": "Date the learner was added to the ELL waitlist"
    },
    "waitlist_status": {
      "type": "string",
      "enum": [
        "waiting",
        "contacted",
        "assessment_booked",
        "not_interested",
        "next_term"
      ],
      "default": "waiting",
      "description": "Light waitlist tracking \u2014 contact state while the learner is waitlisted (waiting = no contact yet; contacted = left message/reached; assessment_booked = CLB assessment scheduled; not_interested = not interested or no answer; next_term = returning for a future term)"
    },
    "last_contacted_date": {
      "type": "string",
      "format": "date",
      "description": "When staff last contacted this waitlist entry"
    },
    "last_contact_note": {
      "type": "string",
      "description": "Note from the most recent contact with this waitlist entry"
    },
    "follow_up_date": {
      "type": "string",
      "format": "date",
      "description": "When to follow up with this waitlist entry next"
    },
    "referral_source": {
      "type": "string",
      "description": "How the learner heard about the program"
    },
    "linked_rc_client_id": {
      "type": "string",
      "description": "Central Database (RCClient) record this learner is linked to \u2014 set when staff pick an existing client file at intake; the central DB sync uses it instead of auto-matching"
    },
    "progress_notes": {
      "type": "string",
      "description": "Notes on learner progress"
    },
    "notes": {
      "type": "string",
      "description": "General notes"
    }
  },
  "required": [
    "first_name",
    "last_name"
  ]
}