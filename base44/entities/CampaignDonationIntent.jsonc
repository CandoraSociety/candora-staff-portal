{
  "name": "CampaignDonationIntent",
  "type": "object",
  "description": "One online gift started on a campaign's public page \u2014 what the supporter chose, the Stripe checkout session it belongs to, and whether the payment came through. Written by the checkout and webhook functions only, so the gift is recorded from a confirmed payment and never from the browser.",
  "properties": {
    "campaign_id": {
      "type": "string",
      "description": "Campaign the gift is for"
    },
    "campaign_name": {
      "type": "string",
      "description": "Campaign name at the time of the gift (denormalized)"
    },
    "campaign_slug": {
      "type": "string",
      "description": "Public page the gift was started from"
    },
    "pillar_id": {
      "type": "string",
      "description": "Fundraising pillar the supporter directed the gift to, when the campaign runs pillars"
    },
    "pillar_name": {
      "type": "string",
      "description": "Pillar name at the time of the gift (denormalized)"
    },
    "session_id": {
      "type": "string",
      "description": "Stripe checkout session id"
    },
    "subscription_id": {
      "type": "string",
      "description": "Stripe subscription id for a monthly gift \u2014 its renewals are matched on this"
    },
    "payment_reference": {
      "type": "string",
      "description": "Stripe payment intent id of the charge"
    },
    "amount": {
      "type": "number",
      "description": "Gift amount in CAD, as resolved on the server from the campaign's giving options \u2014 this is the charitable gift, before any processing fee the supporter covered"
    },
    "fee_amount": {
      "type": "number",
      "description": "Processing fee in CAD the supporter chose to cover, added on top of the gift"
    },
    "charge_amount": {
      "type": "number",
      "description": "Total charged in CAD \u2014 the gift plus any processing fee the supporter covered"
    },
    "currency": {
      "type": "string",
      "default": "cad"
    },
    "product_id": {
      "type": "string",
      "description": "Giving option chosen, when the supporter picked one"
    },
    "product_name": {
      "type": "string",
      "description": "Giving option label, or Custom gift"
    },
    "variation_id": {
      "type": "string",
      "description": "Price variation of the giving option the supporter picked, when the option has several prices"
    },
    "variation_label": {
      "type": "string",
      "description": "How the chosen variation reads, e.g. One week of lunches"
    },
    "frequency": {
      "type": "string",
      "enum": [
        "one_time",
        "monthly"
      ],
      "default": "one_time",
      "description": "Whether the supporter chose to repeat the gift every month"
    },
    "donor_name": {
      "type": "string"
    },
    "donor_email": {
      "type": "string"
    },
    "donor_phone": {
      "type": "string",
      "description": "Mobile number the supporter gave for a thank-you text, when they chose to share one"
    },
    "gift_message": {
      "type": "string",
      "description": "Note the supporter left with their gift"
    },
    "is_anonymous": {
      "type": "boolean",
      "default": false
    },
    "is_gift": {
      "type": "boolean",
      "default": false,
      "description": "Whether the supporter made this gift in someone's honour, to be delivered as a greeting card"
    },
    "recipient_name": {
      "type": "string",
      "description": "Person the gift is for"
    },
    "recipient_email": {
      "type": "string",
      "description": "Where the greeting card is emailed"
    },
    "card_theme_id": {
      "type": "string",
      "description": "Greeting card design chosen from the campaign's e-cards"
    },
    "card_theme_name": {
      "type": "string"
    },
    "card_message": {
      "type": "string",
      "description": "The supporter's own message, written inside the card"
    },
    "deliver_at": {
      "type": "string",
      "format": "date-time",
      "description": "Moment the supporter asked for the card to be delivered. Empty means straight away."
    },
    "app_url": {
      "type": "string",
      "description": "Address of the app the gift was started in, so the card's links open on the right site"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "paid",
        "expired"
      ],
      "default": "pending",
      "enumColors": [
        "yellow",
        "green",
        "gray"
      ],
      "description": "pending = checkout started; paid = confirmed by Stripe; expired = the supporter left checkout"
    },
    "donation_id": {
      "type": "string",
      "description": "Gift recorded once the payment was confirmed"
    },
    "paid_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "campaign_id",
    "amount",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}