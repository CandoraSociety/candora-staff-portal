{
  "name": "CompassBillingVerification",
  "type": "object",
  "properties": {
    "client_id": {
      "type": "string",
      "description": "Linked Client ID"
    },
    "client_name": {
      "type": "string",
      "description": "Denormalized client full name"
    },
    "verified_date": {
      "type": "string",
      "format": "date",
      "description": "Date the client was marked as verified up to date in Compass"
    },
    "verified_by_name": {
      "type": "string",
      "description": "Name of the staff member who marked the client verified"
    },
    "verified_by_email": {
      "type": "string",
      "description": "Email of the staff member who marked the client verified"
    },
    "billing_months": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "YYYY-MM billing months covered by this verification"
    },
    "notes": {
      "type": "string",
      "description": "Free-text notes about keeping this client's Compass entries up to date"
    },
    "notes_updated_date": {
      "type": "string",
      "format": "date",
      "description": "Date the notes were last updated"
    },
    "notes_updated_by_name": {
      "type": "string",
      "description": "Name of the staff member who last updated the notes"
    },
    "corrections_in_crt": {
      "type": "boolean",
      "default": false,
      "description": "True when this client has been flagged as needing corrections in the CRT. While set, the client is shown in the 'Corrections in CRT' section instead of the active or completed lists."
    },
    "corrections_date": {
      "type": "string",
      "format": "date",
      "description": "Date the client was flagged as needing CRT corrections"
    },
    "corrections_by_name": {
      "type": "string",
      "description": "Name of the staff member who flagged the client for CRT corrections"
    },
    "corrections_by_email": {
      "type": "string",
      "description": "Email of the staff member who flagged the client for CRT corrections"
    }
  },
  "required": [
    "client_id"
  ]
}