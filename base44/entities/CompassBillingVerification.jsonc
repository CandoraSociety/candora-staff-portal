{
  "name": "CompassBillingVerification",
  "type": "object",
  "properties": {
    "client_id": {
      "type": "string",
      "description": "Linked Client ID"
    },
    "client_name": {
      "type": "string",
      "description": "Denormalized client full name"
    },
    "verified_date": {
      "type": "string",
      "format": "date",
      "description": "Date the client was marked as verified up to date in Compass"
    },
    "verified_by_name": {
      "type": "string",
      "description": "Name of the staff member who marked the client verified"
    },
    "verified_by_email": {
      "type": "string",
      "description": "Email of the staff member who marked the client verified"
    },
    "billing_months": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "YYYY-MM billing months covered by this verification"
    },
    "notes": {
      "type": "string",
      "description": "Free-text notes about keeping this client's Compass entries up to date"
    },
    "notes_updated_date": {
      "type": "string",
      "format": "date",
      "description": "Date the notes were last updated"
    },
    "notes_updated_by_name": {
      "type": "string",
      "description": "Name of the staff member who last updated the notes"
    }
  },
  "required": [
    "client_id"
  ]
}