{
  "name": "JobApplication",
  "type": "object",
  "description": "A saved job listing or an application being tracked by a Job Lab participant.",
  "properties": {
    "participant_id": {
      "type": "string"
    },
    "company": {
      "type": "string"
    },
    "position": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "job_url": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "saved",
        "applied",
        "phone_screen",
        "interview",
        "offer",
        "rejected",
        "withdrawn"
      ],
      "default": "saved"
    },
    "date_applied": {
      "type": "string",
      "format": "date"
    },
    "deadline": {
      "type": "string",
      "format": "date"
    },
    "salary_range": {
      "type": "string"
    },
    "how_to_apply": {
      "type": "string"
    },
    "application_instructions": {
      "type": "string"
    },
    "job_description": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "follow_up_date": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "participant_id",
    "company",
    "position"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}