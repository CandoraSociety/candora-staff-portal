{
  "name": "CompassTallyVerification",
  "type": "object",
  "properties": {
    "client_id": {
      "type": "string"
    },
    "client_name": {
      "type": "string"
    },
    "billing_month": {
      "type": "string",
      "description": "YYYY-MM \u2014 the Invoice Tracker billing month this verification to-do belongs to."
    },
    "tallies": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Invoice Tracker tally labels this client triggered for the billing month (e.g. 'Exposure Course', 'Service Navigation Fee'). Reconciled by the buildCompassTallyList function."
    },
    "assigned_worker": {
      "type": "string",
      "description": "Email of the client's assigned career counsellor"
    },
    "assigned_worker_name": {
      "type": "string",
      "description": "Name of the client's assigned career counsellor"
    },
    "compass_hsid": {
      "type": "string",
      "description": "Compass HSID# (denormalized from the Client record at reconcile time)"
    },
    "compass_verified": {
      "type": "boolean",
      "description": "Whether the client file was entered into Compass (denormalized from the Client record at reconcile time)"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "verified"
      ],
      "default": "pending",
      "description": "pending = still needs the client's Compass info double-checked; verified = staff confirmed the client's info is correct/up to date in Compass."
    },
    "verified_by": {
      "type": "string",
      "description": "Email of the staff member who confirmed the Compass info"
    },
    "verified_by_name": {
      "type": "string",
      "description": "Name of the staff member who confirmed the Compass info"
    },
    "verified_date": {
      "type": "string",
      "format": "date"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "client_id",
    "client_name",
    "billing_month"
  ]
}