{
  "name": "Employer",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Company / business name"
    },
    "first_name": {
      "type": "string",
      "description": "Contact person's first name"
    },
    "last_name": {
      "type": "string",
      "description": "Contact person's last name"
    },
    "position": {
      "type": "string",
      "description": "Contact person's position / title"
    },
    "contact_name": {
      "type": "string",
      "description": "Denormalized contact full name (first + last)"
    },
    "contact_email": {
      "type": "string",
      "description": "Login email address for the Employer Portal"
    },
    "contact_phone": {
      "type": "string",
      "description": "Contact phone number"
    },
    "alt_contact_name": {
      "type": "string",
      "description": "Alternate contact name"
    },
    "alt_contact_position": {
      "type": "string",
      "description": "Alternate contact position / title"
    },
    "alt_contact_phone": {
      "type": "string",
      "description": "Alternate contact phone"
    },
    "alt_contact_email": {
      "type": "string",
      "description": "Alternate contact email"
    },
    "address": {
      "type": "string",
      "description": "Company address"
    },
    "industry": {
      "type": "string",
      "description": "Industry"
    },
    "payment_payable_to": {
      "type": "string",
      "enum": [
        "employer",
        "client"
      ],
      "default": "employer",
      "description": "Who Candora pays for Work Exposure placements: 'employer' = Candora reimburses the employer (who already paid the client); 'client' = Candora pays the client directly"
    },
    "user_id": {
      "type": "string",
      "description": "Linked platform User ID \u2014 set after invite is accepted or on self-registration"
    },
    "invite_sent": {
      "type": "boolean",
      "default": false,
      "description": "Whether a registration link has been generated/shared with this employer"
    },
    "invite_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "active",
        "inactive"
      ],
      "default": "pending"
    },
    "notes": {
      "type": "string"
    },
    "password_hash": {
      "type": "string",
      "description": "SHA-256 hash of the employer's portal password (self-service portal login, like the volunteer portal)"
    },
    "must_change_password": {
      "type": "boolean",
      "default": true,
      "description": "Force a password change on next portal login"
    }
  },
  "required": [
    "name",
    "contact_email"
  ]
}