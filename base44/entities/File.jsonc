{
  "name": "File",
  "type": "object",
  "properties": {
    "original_name": {
      "type": "string",
      "description": "Original file name as uploaded"
    },
    "standardized_name": {
      "type": "string",
      "description": "Auto-generated standardized file name"
    },
    "display_name": {
      "type": "string",
      "description": "User-friendly display name"
    },
    "description": {
      "type": "string",
      "description": "File description"
    },
    "summary": {
      "type": "string",
      "description": "AI-generated quick access summary"
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Searchable keywords/tags"
    },
    "file_url": {
      "type": "string",
      "description": "Legacy public storage URL \u2014 empty for files stored in SharePoint"
    },
    "sp_item_id": {
      "type": "string",
      "description": "SharePoint drive item id of the stored file (vault storage)"
    },
    "sp_path": {
      "type": "string",
      "description": "SharePoint folder path the file is stored under (e.g. /_VAULT_FileManager/Finance - Invoices)"
    },
    "storage_backend": {
      "type": "string",
      "enum": [
        "sharepoint",
        "base44"
      ],
      "default": "base44",
      "description": "Where the file content lives \u2014 sharepoint vault, or legacy base44 public storage"
    },
    "file_type": {
      "type": "string",
      "description": "File extension/type (pdf, docx, xlsx, etc.)"
    },
    "file_size": {
      "type": "number",
      "description": "File size in bytes"
    },
    "category": {
      "type": "string",
      "description": "File category (value from FileCategory)"
    },
    "subcategory": {
      "type": "string",
      "description": "Optional subcategory for finer classification"
    },
    "access_level": {
      "type": "string",
      "enum": [
        "personal",
        "universal",
        "manager",
        "finance",
        "corporate"
      ],
      "description": "Who can access this file"
    },
    "finance_authorized_emails": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of emails authorized to access finance-level files"
    },
    "owner_email": {
      "type": "string",
      "description": "Email of file owner (for personal files)"
    },
    "owner_name": {
      "type": "string",
      "description": "Name of file owner"
    },
    "source_app": {
      "type": "string",
      "description": "Name of the app that triggered this upload (for cross-app automation)"
    }
  },
  "required": [
    "original_name",
    "file_url",
    "access_level",
    "category"
  ]
}