{
  "name": "MenuItem",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "appetizer",
        "entree",
        "side",
        "dessert",
        "beverage",
        "breakfast",
        "lunch_special",
        "catering"
      ]
    },
    "price": {
      "type": "number"
    },
    "cost": {
      "type": "number"
    },
    "image_url": {
      "type": "string"
    },
    "is_available": {
      "type": "boolean",
      "default": true
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "area": {
      "type": "string",
      "enum": [
        "cafe_candeur",
        "auntie_bevs",
        "community_lunch",
        "catering",
        "general"
      ],
      "description": "Food operation this item is sold in"
    },
    "section_id": {
      "type": "string",
      "description": "Digital menu section the item is listed under"
    },
    "display_order": {
      "type": "number",
      "default": 0,
      "description": "Position within its menu section, lowest first"
    },
    "is_sold_out": {
      "type": "boolean",
      "default": false,
      "description": "Shows the item struck through on the cafe screen until it is available again"
    },
    "is_featured": {
      "type": "boolean",
      "default": false,
      "description": "Marks a staff pick highlighted on the digital menu"
    }
  },
  "required": [
    "name",
    "price"
  ],
  "rls": {
    "read": {},
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}