{
  "name": "FRNSession",
  "type": "object",
  "properties": {
    "program_name": {
      "type": "string",
      "description": "FRN targeted program this session belongs to (Connect Parent Group, Wellness Compass, Neurodivergent Parenting Group, Triple P, Nobody's Perfect)"
    },
    "session_date": {
      "type": "string",
      "format": "date",
      "description": "Date of the session (base date for recurring sessions)"
    },
    "start_time": {
      "type": "string",
      "description": "Start time (HH:MM)"
    },
    "end_time": {
      "type": "string",
      "description": "End time (HH:MM)"
    },
    "location": {
      "type": "string",
      "description": "Location details (shown on calendar listings)"
    },
    "room": {
      "type": "string",
      "enum": [
        "large_classroom",
        "small_classroom",
        "employment_classroom",
        "arc",
        "virtual",
        "other"
      ],
      "description": "Assigned room (Large Classroom, Small Classroom, Employment Classroom, ARC, Virtual, or Other space)"
    },
    "recurrence_pattern": {
      "type": "string",
      "enum": [
        "none",
        "weekly",
        "biweekly",
        "monthly"
      ],
      "default": "none",
      "description": "How the session recurs from the base date (expanded on the Central Registration calendar)"
    },
    "recurrence_end_date": {
      "type": "string",
      "format": "date",
      "description": "Last recurrence date (blank for a one-off session)"
    },
    "facilitator_name": {
      "type": "string",
      "description": "Staff/volunteer facilitating the session"
    },
    "status": {
      "type": "string",
      "enum": [
        "scheduled",
        "completed",
        "cancelled"
      ],
      "default": "scheduled",
      "description": "Session status"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "program_name",
    "session_date"
  ]
}