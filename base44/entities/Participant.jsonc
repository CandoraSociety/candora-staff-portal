{
  "name": "Participant",
  "type": "object",
  "description": "Job Lab participant \u2014 a job seeker at the kiosk or on the public portal. Not a staff user.",
  "properties": {
    "name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "password_hash": {
      "type": "string",
      "description": "Kiosk-grade plain password used by the Job Lab sign-in. Never displayed."
    },
    "session_token": {
      "type": "string",
      "description": "Random per-login token the Job Lab backend requires with every request from this participant."
    },
    "pathways_client_id": {
      "type": "string",
      "description": "Pathways casual Client record this participant is filed under \u2014 set the first time they sign in"
    },
    "is_guest": {
      "type": "boolean",
      "default": false
    },
    "total_visits": {
      "type": "number",
      "default": 1
    },
    "last_visit": {
      "type": "string",
      "format": "date-time"
    },
    "education": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "institution": {
            "type": "string"
          },
          "degree": {
            "type": "string"
          },
          "field": {
            "type": "string"
          },
          "start_year": {
            "type": "string"
          },
          "end_year": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "experience": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "company": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "start_date": {
            "type": "string"
          },
          "end_date": {
            "type": "string"
          },
          "current": {
            "type": "boolean"
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "interests": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "career_goals": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "email"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}