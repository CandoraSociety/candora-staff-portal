{
  "name": "DigiLitSession",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Session title/topic (e.g. 'Email Basics', 'Internet Safety')"
    },
    "session_date": {
      "type": "string",
      "format": "date",
      "description": "Date of the session (base date for recurring sessions)"
    },
    "start_time": {
      "type": "string",
      "description": "Start time (HH:MM)"
    },
    "end_time": {
      "type": "string",
      "description": "End time (HH:MM)"
    },
    "location": {
      "type": "string",
      "description": "Where the session is held"
    },
    "room": {
      "type": "string",
      "enum": [
        "large_classroom",
        "small_classroom",
        "employment_classroom",
        "arc",
        "virtual",
        "other"
      ],
      "description": "Assigned room (Large Classroom, Small Classroom, Employment Classroom, ARC, Virtual, or Other space)"
    },
    "recurrence_pattern": {
      "type": "string",
      "enum": [
        "none",
        "weekly",
        "biweekly",
        "monthly"
      ],
      "default": "none",
      "description": "How the session recurs from the base date (expanded on the Central Registration calendar)"
    },
    "recurrence_end_date": {
      "type": "string",
      "format": "date",
      "description": "Last recurrence date (blank for a one-off session)"
    },
    "completed_dates": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "date"
      },
      "description": "For recurring sessions \u2014 occurrence dates (YYYY-MM-DD) that have been completed, tracked per date instead of completing the whole series"
    },
    "facilitator_name": {
      "type": "string",
      "description": "Volunteer facilitator leading the session"
    },
    "facilitator_email": {
      "type": "string"
    },
    "topic_area": {
      "type": "string",
      "enum": [
        "computer_basics",
        "internet_email",
        "smartphone_basics",
        "online_safety",
        "job_search_online",
        "office_software",
        "social_media",
        "other"
      ],
      "default": "computer_basics",
      "description": "Topic category"
    },
    "max_participants": {
      "type": "number",
      "default": 10
    },
    "registered_participant_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs of registered DigiLitParticipants"
    },
    "attended_participant_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs of participants who attended"
    },
    "status": {
      "type": "string",
      "enum": [
        "scheduled",
        "completed",
        "cancelled"
      ],
      "default": "scheduled"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "session_date"
  ]
}