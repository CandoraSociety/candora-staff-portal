{
  "name": "WebsiteSettings",
  "type": "object",
  "description": "Site-wide content for Candora's public website \u2014 the logo, brand line, hero area, news feed style, home page pop-up, contact details and how events are introduced on the home page. Edited only from Website Studio; the separate website app reads it through the public feed.",
  "properties": {
    "site_name": {
      "type": "string",
      "description": "Organization name shown in the site header"
    },
    "logo_url": {
      "type": "string",
      "description": "Logo shown in the website header and footer. Left empty, the site uses the primary logo chosen in Marketing \u2192 Brand Assets."
    },
    "tagline": {
      "type": "string",
      "description": "Short line under the site name"
    },
    "hero_headline": {
      "type": "string",
      "description": "Main headline on the website home page"
    },
    "hero_subheadline": {
      "type": "string",
      "description": "Supporting sentence under the hero headline"
    },
    "hero_image_url": {
      "type": "string",
      "description": "Photo behind the home page hero (publicly stored file URL)"
    },
    "hero_cta_label": {
      "type": "string",
      "description": "Button label in the hero area"
    },
    "hero_cta_url": {
      "type": "string",
      "description": "Where the hero button goes \u2014 a page path or an outside link"
    },
    "about_summary": {
      "type": "string",
      "description": "Short organization summary used on the home and about pages"
    },
    "events_heading": {
      "type": "string",
      "description": "Heading above the events advertised on the home page"
    },
    "events_intro": {
      "type": "string",
      "description": "One line shown under the events heading"
    },
    "news_feed_style": {
      "type": "string",
      "enum": [
        "grid",
        "scroll",
        "fade",
        "list"
      ],
      "enumColors": [
        "blue",
        "purple",
        "yellow",
        "gray"
      ],
      "default": "grid",
      "description": "How published news posts are shown on the website \u2014 grid of cards, a scrolling row, one post at a time fading in and out, or a simple list."
    },
    "news_feed_speed": {
      "type": "string",
      "enum": [
        "slow",
        "normal",
        "fast"
      ],
      "enumColors": [
        "gray",
        "blue",
        "yellow"
      ],
      "default": "normal",
      "description": "How quickly a scrolling or fading news feed moves"
    },
    "news_feed_pause_on_hover": {
      "type": "boolean",
      "default": true,
      "description": "Whether the news feed stops moving while a visitor points at it"
    },
    "news_feed_limit": {
      "type": "number",
      "default": 6,
      "description": "How many news posts the website shows at once"
    },
    "popup_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Whether a pop-up opens over the website when someone lands on the home page"
    },
    "popup_title": {
      "type": "string",
      "description": "Headline of the home page pop-up"
    },
    "popup_message": {
      "type": "string",
      "description": "Body text of the pop-up"
    },
    "popup_image_url": {
      "type": "string",
      "description": "Optional photo at the top of the pop-up (publicly stored file URL)"
    },
    "popup_button_label": {
      "type": "string",
      "description": "Optional button label, e.g. Donate now"
    },
    "popup_button_url": {
      "type": "string",
      "description": "Where the pop-up's button goes \u2014 a page path or an outside link"
    },
    "popup_frequency": {
      "type": "string",
      "enum": [
        "every_visit",
        "once_per_session",
        "once_per_day"
      ],
      "enumColors": [
        "yellow",
        "blue",
        "green"
      ],
      "default": "once_per_session",
      "description": "How often the same visitor sees the pop-up"
    },
    "contact_email": {
      "type": "string"
    },
    "contact_phone": {
      "type": "string"
    },
    "contact_address": {
      "type": "string"
    },
    "office_hours": {
      "type": "string"
    },
    "charity_number": {
      "type": "string",
      "description": "Registered charity number shown in the site footer"
    },
    "footer_note": {
      "type": "string",
      "description": "Closing line in the site footer"
    },
    "public_site_url": {
      "type": "string",
      "description": "Live address of the public website, e.g. https://candora.ca. A gift started on the website is sent back to this address after payment, so supporters finish on the site they started on."
    },
    "social_links": {
      "type": "array",
      "description": "Social profiles shown in the site footer",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "description": "Platform name, e.g. Facebook"
          },
          "url": {
            "type": "string"
          }
        }
      }
    },
    "updated_by_name": {
      "type": "string",
      "description": "Staff member who last saved the site settings"
    }
  },
  "required": [
    "site_name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}