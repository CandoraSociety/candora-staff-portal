{
  "name": "EmpowerUCohort",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Cohort name (e.g. 'EmpowerU Fall 2026')"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "description": "Program start date"
    },
    "end_date": {
      "type": "string",
      "format": "date",
      "description": "Program end date (10 weeks after start)"
    },
    "delivery_mode": {
      "type": "string",
      "enum": [
        "in_person",
        "virtual",
        "hybrid"
      ],
      "default": "virtual",
      "description": "How the program is delivered \u2014 when 'virtual', the room is always set to Virtual automatically"
    },
    "location": {
      "type": "string",
      "description": "Physical location or meeting link"
    },
    "room": {
      "type": "string",
      "enum": [
        "large_classroom",
        "small_classroom",
        "employment_classroom",
        "arc",
        "echo_valley",
        "virtual",
        "other"
      ],
      "description": "Assigned room (Large Classroom, Small Classroom, Employment Classroom, ARC, Echo Valley, Virtual, or Other space) \u2014 always 'virtual' when delivery mode is Virtual"
    },
    "facilitator_name": {
      "type": "string",
      "description": "Contractor facilitating the program"
    },
    "facilitator_email": {
      "type": "string"
    },
    "facilitator_phone": {
      "type": "string"
    },
    "capacity": {
      "type": "number",
      "default": 15,
      "description": "Maximum number of participants"
    },
    "registration_open": {
      "type": "boolean",
      "default": false,
      "description": "Whether registration is currently open \u2014 the single toggle that opens/closes the public registration link (there is no separate 'Registration Open' status)"
    },
    "registration_deadline": {
      "type": "string",
      "format": "date",
      "description": "Registration cutoff date"
    },
    "status": {
      "type": "string",
      "enum": [
        "planning",
        "in_progress",
        "completed",
        "cancelled"
      ],
      "default": "planning",
      "description": "Cohort lifecycle status"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "name"
  ]
}