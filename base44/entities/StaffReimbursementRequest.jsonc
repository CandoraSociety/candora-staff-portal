{
  "name": "StaffReimbursementRequest",
  "type": "object",
  "properties": {
    "requester_name": {
      "type": "string",
      "description": "Full name of the staff member who submitted the reimbursement form"
    },
    "requester_email": {
      "type": "string",
      "description": "Email of the staff member who submitted the form"
    },
    "payable_to": {
      "type": "string",
      "description": "Cheque Payable to: who the cheque should be made out to"
    },
    "etransfer_email": {
      "type": "string",
      "description": "E-transfer email for the payment (shown beside Cheque Payable to on the form)"
    },
    "requested_by": {
      "type": "string",
      "description": "Requested by: name on the form"
    },
    "date_requested": {
      "type": "string",
      "format": "date",
      "description": "Date Requested: date on the reimbursement form"
    },
    "staff_signature": {
      "type": "string",
      "description": "Staff e-Signature: name of the requesting staff member, captured at submission"
    },
    "staff_signature_url": {
      "type": "string",
      "description": "PNG image of the staff member's captured e-signature (with embedded verification ID and timestamp), printed on the Staff e-Signature line of the form"
    },
    "finance_signature": {
      "type": "string",
      "description": "Finance e-Signature: name of the finance staff member who approved the form or confirmed payment \u2014 printed as 'Financial Officer Approval' on the downloadable form"
    },
    "finance_signature_url": {
      "type": "string",
      "description": "PNG image of the finance officer's captured e-signature \u2014 printed on the Financial Officer Approval line of the form"
    },
    "approved_by": {
      "type": "string",
      "enum": [
        "Jim Cunningham",
        "Graham Currie"
      ],
      "description": "Finance approver selected when the payment is confirmed \u2014 shown in both the finance and staff portals"
    },
    "department": {
      "type": "string",
      "enum": [
        "Administration",
        "Operations",
        "Finance",
        "Human Resources",
        "Marketing",
        "IT",
        "Pathways",
        "Food Services",
        "Facilities",
        "Childcare",
        "Fundraising",
        "Reception",
        "Other"
      ],
      "description": "Department the expenses relate to"
    },
    "entry_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs of the ReimbursementEntry records (individual receipts) compiled into this form by Submit for Reimbursement"
    },
    "entry_count": {
      "type": "number",
      "description": "Number of individual receipt entries compiled into this form"
    },
    "amount": {
      "type": "number",
      "description": "Total Requested \u2014 sum of all entry total costs (with GST). This is the amount to be reimbursed."
    },
    "tax": {
      "type": "number",
      "description": "Total GST across all entries (documented only). The full amount is reimbursed regardless."
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "processing",
        "approved",
        "paid",
        "rejected"
      ],
      "default": "pending",
      "description": "pending = submitted and supervisor-approved, awaiting finance (staff can still edit its entries); processing = finance is processing it \u2014 locked for staff edits until unselected; approved = verified by finance; paid = reimbursement paid out (locked); rejected = declined by supervisor or finance"
    },
    "supervisor_email": {
      "type": "string",
      "description": "Direct supervisor's email \u2014 the submission is routed to them for approval before Finance processing"
    },
    "supervisor_name": {
      "type": "string",
      "description": "Direct supervisor's display name (denormalized for display)"
    },
    "supervisor_status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending",
      "description": "Supervisor approval stage: pending = awaiting the direct supervisor's approval (shown in the finance portal's Pending Supervisor Approval section); approved = supervisor approved, moves on to Finance; rejected = declined by the supervisor"
    },
    "supervisor_approved_date": {
      "type": "string",
      "format": "date",
      "description": "Date the supervisor approved or rejected the submission"
    },
    "supervisor_approved_by_name": {
      "type": "string",
      "description": "Name of the supervisor who approved/rejected the submission"
    },
    "supervisor_signature": {
      "type": "string",
      "description": "Supervisor e-Signature: name of the supervisor who approved the submission, captured at approval \u2014 printed on the Approved by line of the downloadable form"
    },
    "supervisor_signature_url": {
      "type": "string",
      "description": "PNG image of the supervisor's captured e-signature \u2014 printed on the Approved by line of the downloadable form"
    },
    "supervisor_rejection_reason": {
      "type": "string",
      "description": "Why the supervisor rejected the submission"
    },
    "submitted_date": {
      "type": "string",
      "format": "date",
      "description": "Date the form was submitted for reimbursement (auto-set)"
    },
    "reviewed_by": {
      "type": "string",
      "description": "Email of the finance staff who reviewed the form"
    },
    "reviewed_by_name": {
      "type": "string",
      "description": "Name of the finance staff who reviewed the form"
    },
    "reviewed_date": {
      "type": "string",
      "format": "date",
      "description": "Date the form was approved or rejected"
    },
    "payment_date": {
      "type": "string",
      "format": "date",
      "description": "Date the reimbursement was paid out to the staff member"
    },
    "rejection_reason": {
      "type": "string",
      "description": "Why the form was rejected"
    },
    "notes": {
      "type": "string",
      "description": "Notes about this form"
    }
  },
  "required": [
    "requester_name",
    "requester_email",
    "payable_to",
    "amount"
  ]
}