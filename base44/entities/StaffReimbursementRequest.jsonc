{
  "name": "StaffReimbursementRequest",
  "type": "object",
  "properties": {
    "requester_name": {
      "type": "string",
      "description": "Full name of the staff member requesting reimbursement"
    },
    "requester_email": {
      "type": "string",
      "description": "Email of the staff member requesting reimbursement"
    },
    "payable_to": {
      "type": "string",
      "description": "Cheque Payable to: who the cheque should be made out to"
    },
    "etransfer_email": {
      "type": "string",
      "description": "E-transfer email for the payment (shown beside Cheque Payable to on the form)"
    },
    "requested_by": {
      "type": "string",
      "description": "Requested by: name on the form"
    },
    "date_requested": {
      "type": "string",
      "format": "date",
      "description": "Date Requested: date on the cheque request form"
    },
    "staff_signature": {
      "type": "string",
      "description": "Staff Signature: typed name of the requesting staff member"
    },
    "verified_by": {
      "type": "string",
      "description": "Verified by: name of the person who verified the request (filled during review)"
    },
    "line_items": {
      "type": "array",
      "description": "Expense lines on the cheque request form (one row per receipt)",
      "items": {
        "type": "object",
        "properties": {
          "receipt_no": {
            "type": "string",
            "description": "Receipt #"
          },
          "date": {
            "type": "string",
            "format": "date",
            "description": "Date of purchase"
          },
          "program": {
            "type": "string",
            "description": "Program the expense relates to"
          },
          "supplier": {
            "type": "string",
            "description": "Supplier (where the purchase was made)"
          },
          "description": {
            "type": "string",
            "description": "Description (items purchased)"
          },
          "total_cost": {
            "type": "number",
            "description": "Total cost (with GST)"
          },
          "gst": {
            "type": "number",
            "description": "GST portion of the total cost"
          },
          "half_gst": {
            "type": "number",
            "description": "Half of the GST portion"
          },
          "funder_cost": {
            "type": "number",
            "description": "Funder cost"
          },
          "account_no": {
            "type": "string",
            "description": "Account #"
          },
          "funder_no": {
            "type": "string",
            "description": "Funder #"
          },
          "receipt_url": {
            "type": "string",
            "description": "Uploaded receipt image/file for this line"
          }
        }
      }
    },
    "department": {
      "type": "string",
      "enum": [
        "Administration",
        "Operations",
        "Finance",
        "Human Resources",
        "Marketing",
        "IT",
        "Pathways",
        "Food Services",
        "Facilities",
        "Childcare",
        "Fundraising",
        "Reception",
        "Other"
      ],
      "description": "Department the expense relates to"
    },
    "expense_category": {
      "type": "string",
      "enum": [
        "travel",
        "mileage",
        "parking",
        "supplies",
        "meals",
        "training",
        "equipment",
        "software",
        "office",
        "other"
      ],
      "description": "Category of personal expense incurred for the organization"
    },
    "expense_category_other": {
      "type": "string",
      "description": "If expense category is 'other', specify"
    },
    "description": {
      "type": "string",
      "description": "What the expense was for"
    },
    "vendor": {
      "type": "string",
      "description": "Where the purchase was made (store, service, etc.)"
    },
    "date_incurred": {
      "type": "string",
      "format": "date",
      "description": "Date the expense was incurred by the staff member"
    },
    "amount": {
      "type": "number",
      "description": "Total Requested \u2014 sum of all line item total costs (with GST). This is the amount to be reimbursed."
    },
    "tax": {
      "type": "number",
      "description": "Tax portion of the amount (documented only). The full amount is reimbursed regardless."
    },
    "receipt_url": {
      "type": "string",
      "description": "Uploaded receipt for the expense"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "paid",
        "rejected"
      ],
      "default": "pending",
      "description": "Workflow status of the reimbursement request"
    },
    "submitted_date": {
      "type": "string",
      "format": "date",
      "description": "Date the request was submitted (auto-set)"
    },
    "reviewed_by": {
      "type": "string",
      "description": "Email of the finance staff who reviewed the request"
    },
    "reviewed_by_name": {
      "type": "string"
    },
    "reviewed_date": {
      "type": "string",
      "format": "date",
      "description": "Date the request was approved or rejected"
    },
    "payment_date": {
      "type": "string",
      "format": "date",
      "description": "Date the reimbursement was paid out to the staff member"
    },
    "rejection_reason": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "requester_name",
    "requester_email",
    "payable_to",
    "amount"
  ]
}