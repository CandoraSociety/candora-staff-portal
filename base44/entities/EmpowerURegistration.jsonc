{
  "name": "EmpowerURegistration",
  "type": "object",
  "properties": {
    "participant_id": {
      "type": "string",
      "description": "Reference to EmpowerUParticipant"
    },
    "participant_name": {
      "type": "string",
      "description": "Denormalized participant name"
    },
    "cohort_id": {
      "type": "string",
      "description": "Reference to EmpowerUCohort"
    },
    "cohort_name": {
      "type": "string",
      "description": "Denormalized cohort name"
    },
    "application_id": {
      "type": "string",
      "description": "Reference to the EmpowerUApplication submitted via the participant's personal waitlist registration link \u2014 set when the application moves the registration off the waitlist; used at approval to avoid creating a duplicate participant and registration"
    },
    "registration_date": {
      "type": "string",
      "format": "date",
      "description": "Date of registration"
    },
    "status": {
      "type": "string",
      "enum": [
        "registered",
        "waitlisted",
        "enrolled",
        "withdrawn",
        "completed",
        "declined"
      ],
      "default": "registered",
      "description": "Registration status in the cohort"
    },
    "waitlist_position": {
      "type": "number",
      "description": "Position on the waitlist (if waitlisted)"
    },
    "waitlist_status": {
      "type": "string",
      "enum": [
        "waiting",
        "contacted",
        "form_sent",
        "not_interested",
        "next_session"
      ],
      "default": "waiting",
      "description": "Light waitlist tracking \u2014 contact state while this registration is waitlisted (waiting = no contact yet; contacted = left message/reached; form_sent = application form emailed; not_interested = not interested or no answer; next_session = registered but for a future session)"
    },
    "last_contacted_date": {
      "type": "string",
      "format": "date",
      "description": "When staff last contacted this waitlist entry"
    },
    "last_contact_note": {
      "type": "string",
      "description": "Note from the most recent contact with this waitlist entry"
    },
    "follow_up_date": {
      "type": "string",
      "format": "date",
      "description": "When to follow up with this waitlist entry next"
    },
    "preferred_delivery_mode": {
      "type": "string",
      "enum": [
        "in_person",
        "virtual",
        "no_preference"
      ],
      "default": "no_preference",
      "description": "Participant's preferred delivery mode"
    },
    "accommodation_needs": {
      "type": "string",
      "description": "Any accommodation needs (childcare, accessibility, etc.)"
    },
    "intake_notes": {
      "type": "string",
      "description": "Notes from intake/registration"
    },
    "notes": {
      "type": "string"
    },
    "cp_registration_form": {
      "type": "boolean",
      "default": false,
      "description": "Completion checkpoint \u2014 Registration Form (auto-marked complete when a public-link application is approved)"
    },
    "cp_qualtrics": {
      "type": "boolean",
      "default": false,
      "description": "Completion checkpoint \u2014 Qualtrics: mandatory United Way/EmpowerU online registration/data-entry step completed before the participant begins the program"
    },
    "cp_binder": {
      "type": "boolean",
      "default": false,
      "description": "Completion checkpoint \u2014 Binder received/set up"
    },
    "cp_pre_asset_map": {
      "type": "boolean",
      "default": false,
      "description": "Completion checkpoint \u2014 Pre-Asset Map completed"
    },
    "cp_post_asset_map": {
      "type": "boolean",
      "default": false,
      "description": "Completion checkpoint \u2014 Post-Asset Map completed"
    },
    "cp_post_questionnaire": {
      "type": "boolean",
      "default": false,
      "description": "Completion checkpoint \u2014 Post-Questionnaire completed"
    },
    "cp_completion_form": {
      "type": "boolean",
      "default": false,
      "description": "Completion checkpoint \u2014 Program Completion Form completed"
    },
    "cp_asset_description": {
      "type": "boolean",
      "default": false,
      "description": "Completion checkpoint \u2014 Asset Description Form completed"
    },
    "ambassador_name": {
      "type": "string",
      "description": "Informational \u2014 ATB/EmpowerU Ambassador associated with the participant's banking and matched-savings setup (not the participant's financial coach)"
    },
    "bank_account_opened": {
      "type": "boolean",
      "default": false,
      "description": "Informational \u2014 savings bank account opened"
    },
    "bank_representative": {
      "type": "string",
      "description": "Informational \u2014 bank representative name"
    },
    "bank_representative_phone": {
      "type": "string",
      "description": "Informational \u2014 bank representative phone"
    },
    "bank_representative_email": {
      "type": "string",
      "description": "Informational \u2014 bank representative email"
    },
    "bank": {
      "type": "string",
      "description": "Informational \u2014 bank/branch"
    },
    "account_type": {
      "type": "string",
      "description": "Informational \u2014 account type"
    },
    "savings_goal": {
      "type": "string",
      "description": "Informational \u2014 participant's savings goal"
    },
    "atb_amount": {
      "type": "number",
      "description": "Informational \u2014 $ ATB (manually edited; exact operational meaning not yet confirmed)"
    },
    "saved_amount": {
      "type": "number",
      "description": "Informational \u2014 $ Saved (manually edited)"
    },
    "total_amount": {
      "type": "number",
      "description": "Informational \u2014 Total (manually edited; not auto-calculated until the relationship between $ ATB, $ Saved and Total is confirmed)"
    },
    "progress_notes": {
      "type": "string",
      "description": "Participant-specific operational notes, outstanding issues, exceptions or follow-up information for this cohort"
    }
  },
  "required": [
    "participant_id",
    "cohort_id",
    "registration_date"
  ]
}