{
  "name": "InvoicePackage",
  "type": "object",
  "properties": {
    "package_number": {
      "type": "string"
    },
    "billing_month": {
      "type": "string",
      "description": "YYYY-MM \u2014 the first month of this package's submission range."
    },
    "billing_month_end": {
      "type": "string",
      "description": "YYYY-MM \u2014 the last month of this package's submission range (inclusive). When blank or equal to billing_month, the package covers a single month. When set to a later month, childminding and other month-filtered tabs span the full range."
    },
    "prepared_by": {
      "type": "string"
    },
    "prepared_by_name": {
      "type": "string"
    },
    "prepared_date": {
      "type": "string",
      "format": "date"
    },
    "config_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "ready_for_review",
        "submitted",
        "approved",
        "paid"
      ],
      "default": "draft"
    },
    "notes": {
      "type": "string"
    },
    "note_entries": {
      "type": "array",
      "description": "Categorized notes attached to this package (e.g. invoice adjustment instructions). Each entry stores its type, free-text body, author and date.",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "invoice_adjustment",
              "general",
              "reminder",
              "follow_up"
            ]
          },
          "text": {
            "type": "string"
          },
          "created_by_name": {
            "type": "string"
          },
          "created_date": {
            "type": "string",
            "format": "date"
          }
        }
      }
    },
    "adjustment_notes": {
      "type": "array",
      "description": "Structured notes auto-created when a Manual Adjustment is applied to the Invoice Tracker. Each entry records the cell changed (old \u2192 new value), the client it applies to, the reason, and a field-note instruction for the Client Data sheet.",
      "items": {
        "type": "object",
        "properties": {
          "cell_letter": {
            "type": "string"
          },
          "cell_label": {
            "type": "string"
          },
          "old_value": {
            "type": "string"
          },
          "new_value": {
            "type": "string"
          },
          "client_id": {
            "type": "string"
          },
          "client_name": {
            "type": "string"
          },
          "comment": {
            "type": "string"
          },
          "created_by_name": {
            "type": "string"
          },
          "created_date": {
            "type": "string",
            "format": "date"
          },
          "billing_month": {
            "type": "string"
          }
        }
      }
    },
    "crt_included": {
      "type": "boolean",
      "default": true
    },
    "invoice_id": {
      "type": "string"
    },
    "supporting_documents": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "paid_placements": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "auto_populated_items": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "manual_uploads": {
      "type": "array",
      "description": "Staff-uploaded backup documents attached to this package, grouped by category (crt, invoice, childminding, work_exposure, reimbursement, supporting). Used as a fallback when the auto-gathered document for a category is missing or incorrect; included in the package ZIP under the matching category folder.",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "category": {
            "type": "string",
            "enum": [
              "crt",
              "invoice",
              "childminding",
              "work_exposure",
              "reimbursement",
              "supporting"
            ]
          },
          "file_url": {
            "type": "string"
          },
          "file_name": {
            "type": "string"
          },
          "uploaded_date": {
            "type": "string",
            "format": "date"
          },
          "uploaded_by_name": {
            "type": "string"
          }
        }
      }
    },
    "work_exposure_pdf_url": {
      "type": "string",
      "format": "uri",
      "description": "Auto-generated Candora-branded PDF of the month's Work Exposure Payments list, produced when the package is created."
    },
    "work_exposure_pdf_name": {
      "type": "string"
    },
    "reimbursement_pdf_url": {
      "type": "string",
      "format": "uri",
      "description": "Auto-generated Candora-branded combined PDF of the month's Employment Supports and Exposure Courses lists, produced when the package is created."
    },
    "reimbursement_pdf_name": {
      "type": "string"
    },
    "ariba_submission_url": {
      "type": "string",
      "format": "uri",
      "description": "SAP Ariba submission confirmation document uploaded when the package is marked Submitted."
    },
    "ariba_submission_name": {
      "type": "string",
      "description": "File name of the SAP Ariba submission confirmation document."
    },
    "ariba_submission_date": {
      "type": "string",
      "format": "date",
      "description": "Date the SAP Ariba submission confirmation was uploaded."
    },
    "ariba_submission_by_name": {
      "type": "string",
      "description": "Name of the staff member who uploaded the SAP Ariba submission confirmation."
    }
  },
  "required": [
    "billing_month",
    "prepared_by"
  ]
}