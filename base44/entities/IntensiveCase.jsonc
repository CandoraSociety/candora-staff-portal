{
  "name": "IntensiveCase",
  "type": "object",
  "properties": {
    "client_id": {
      "type": "string",
      "description": "Linked RCClient ID (client with service_category = intensive_services)"
    },
    "client_name": {
      "type": "string",
      "description": "Denormalized client full name"
    },
    "current_stage": {
      "type": "string",
      "description": "Stage key currently active in the Building Resilient Caregivers workflow"
    },
    "stages": {
      "type": "array",
      "description": "Ordered workflow stages with per-stage status, dates, and notes",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "description": "Stage key"
          },
          "label": {
            "type": "string",
            "description": "Stage label"
          },
          "status": {
            "type": "string",
            "enum": [
              "not_started",
              "in_progress",
              "complete"
            ],
            "default": "not_started",
            "description": "Stage completion status"
          },
          "start_date": {
            "type": "string",
            "format": "date"
          },
          "completed_date": {
            "type": "string",
            "format": "date"
          },
          "notes": {
            "type": "string",
            "description": "Stage notes"
          }
        }
      }
    },
    "tasks": {
      "type": "array",
      "description": "Case management tasks tied to stages",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "stage_key": {
            "type": "string",
            "description": "Stage this task belongs to"
          },
          "status": {
            "type": "string",
            "enum": [
              "todo",
              "in_progress",
              "done"
            ],
            "default": "todo"
          },
          "due_date": {
            "type": "string",
            "format": "date"
          },
          "assigned_to": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "created_date": {
            "type": "string",
            "format": "date"
          },
          "completed_date": {
            "type": "string",
            "format": "date"
          }
        }
      }
    },
    "risk_factors": {
      "type": "array",
      "description": "Risks related to family, individual, or child stability or safety",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "category": {
            "type": "string",
            "enum": [
              "family",
              "individual",
              "child"
            ]
          },
          "description": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "monitoring",
              "mitigated"
            ],
            "default": "active"
          },
          "mitigation": {
            "type": "string",
            "description": "Mitigation plan / actions taken"
          },
          "date_identified": {
            "type": "string",
            "format": "date"
          },
          "review_date": {
            "type": "string",
            "format": "date"
          }
        }
      }
    },
    "objectives": {
      "type": "array",
      "description": "Case plan objectives for the client",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "text": {
            "type": "string",
            "description": "Objective"
          },
          "target_date": {
            "type": "string",
            "format": "date"
          },
          "status": {
            "type": "string",
            "enum": [
              "in_progress",
              "achieved",
              "revised",
              "dropped"
            ],
            "default": "in_progress"
          },
          "achieved_date": {
            "type": "string",
            "format": "date"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "created_by_name": {
      "type": "string"
    }
  },
  "required": [
    "client_id"
  ]
}