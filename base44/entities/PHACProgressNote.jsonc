{
  "name": "PHACProgressNote",
  "type": "object",
  "description": "A progress, observation or contact note recorded against a PHAC family \u2014 what staff see of the child and caregiver over time.",
  "properties": {
    "participant_id": {
      "type": "string",
      "description": "PHAC family (PHACParticipant) this note belongs to"
    },
    "participant_name": {
      "type": "string",
      "description": "Family name (denormalized so lists read without a lookup)"
    },
    "program_name": {
      "type": "string",
      "description": "Program the note was recorded against"
    },
    "note_date": {
      "type": "string",
      "format": "date",
      "description": "Date of the observation or contact"
    },
    "category": {
      "type": "string",
      "enum": [
        "observation",
        "development",
        "contact",
        "general"
      ],
      "default": "observation",
      "description": "What kind of note this is"
    },
    "progress_rating": {
      "type": "string",
      "enum": [
        "thriving",
        "on_track",
        "needs_support",
        "follow_up"
      ],
      "description": "Overall read on the family at this point"
    },
    "summary": {
      "type": "string",
      "description": "What happened, what was observed, what it means"
    },
    "next_steps": {
      "type": "string",
      "description": "Follow-up actions for the next contact"
    },
    "recorded_by_name": {
      "type": "string",
      "description": "Staff member who wrote the note"
    }
  },
  "required": [
    "participant_id",
    "note_date",
    "summary"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}