{
  "name": "CompassTask",
  "type": "object",
  "properties": {
    "client_id": {
      "type": "string"
    },
    "client_name": {
      "type": "string"
    },
    "compass_hsid": {
      "type": "string"
    },
    "task_type": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "instructions": {
      "type": "string"
    },
    "triggered_by": {
      "type": "string"
    },
    "triggered_by_name": {
      "type": "string"
    },
    "assigned_worker": {
      "type": "string"
    },
    "assigned_worker_name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "completed"
      ],
      "default": "pending"
    },
    "completed_by": {
      "type": "string"
    },
    "completed_by_name": {
      "type": "string"
    },
    "completed_date": {
      "type": "string",
      "format": "date"
    },
    "completed_notes": {
      "type": "string"
    },
    "is_scratched": {
      "type": "boolean",
      "default": false,
      "description": "True when the portal action that created this task was undone. The task is kept visible (in the Scratched tab) with a note asking whether Compass needs updating, rather than deleted."
    },
    "scratch_note": {
      "type": "string",
      "description": "Note attached when the task was scratched (e.g. 'This action was undone. Does this need to be changed in Compass?')."
    }
  },
  "required": [
    "client_id",
    "title",
    "instructions"
  ]
}