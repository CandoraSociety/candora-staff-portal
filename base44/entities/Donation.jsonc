{
  "name": "Donation",
  "type": "object",
  "properties": {
    "donor_id": {
      "type": "string"
    },
    "donor_name": {
      "type": "string"
    },
    "amount": {
      "type": "number"
    },
    "donation_date": {
      "type": "string",
      "format": "date"
    },
    "donation_type": {
      "type": "string",
      "enum": [
        "one_time",
        "recurring_monthly",
        "recurring_annual",
        "in_kind",
        "pledge"
      ],
      "default": "one_time"
    },
    "campaign_id": {
      "type": "string"
    },
    "campaign_name": {
      "type": "string"
    },
    "product_name": {
      "type": "string",
      "description": "Giving option the supporter chose on the campaign page, e.g. Sponsor a lunch"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "cash",
        "cheque",
        "credit_card",
        "e_transfer",
        "online",
        "other"
      ]
    },
    "source": {
      "type": "string",
      "enum": [
        "manual",
        "online_campaign"
      ],
      "default": "manual",
      "enumColors": [
        "gray",
        "blue"
      ],
      "description": "manual = recorded by staff; online_campaign = paid by a supporter on a campaign's public page"
    },
    "payment_reference": {
      "type": "string",
      "description": "Payment provider reference for an online gift, kept for reconciliation"
    },
    "donor_email": {
      "type": "string",
      "description": "Email the supporter gave at checkout (online gifts)"
    },
    "gift_message": {
      "type": "string",
      "description": "Note the supporter left with an online gift"
    },
    "is_anonymous": {
      "type": "boolean",
      "default": false,
      "description": "Whether the supporter asked not to be named"
    },
    "receipt_issued": {
      "type": "boolean",
      "default": false
    },
    "receipt_number": {
      "type": "string"
    },
    "receipt_date": {
      "type": "string",
      "format": "date"
    },
    "in_kind_description": {
      "type": "string"
    },
    "in_kind_value": {
      "type": "number"
    },
    "notes": {
      "type": "string"
    },
    "recorded_by": {
      "type": "string"
    },
    "recorded_by_name": {
      "type": "string"
    }
  },
  "required": [
    "donor_id",
    "amount",
    "donation_date"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}