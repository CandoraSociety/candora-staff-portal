{
  "name": "PurchaseRequest",
  "type": "object",
  "properties": {
    "client_id": {
      "type": "string",
      "description": "Linked Client ID"
    },
    "client_name": {
      "type": "string",
      "description": "Denormalized client full name"
    },
    "support_type": {
      "type": "string",
      "description": "Type of employment support (PPE, Bus Pass, Work Clothes, etc.)"
    },
    "support_type_other": {
      "type": "string",
      "description": "If support type is 'Other', specify"
    },
    "description": {
      "type": "string"
    },
    "product_link": {
      "type": "string",
      "description": "URL link to the product to be purchased"
    },
    "purchase_exact_item": {
      "type": "boolean",
      "default": false,
      "description": "Whether the manager should purchase the exact item shown in the product link"
    },
    "estimated_amount": {
      "type": "number",
      "description": "Estimated cost of the purchase"
    },
    "vendor": {
      "type": "string"
    },
    "requested_date": {
      "type": "string",
      "format": "date",
      "description": "Date the request was submitted (auto-set to the current date, not editable)"
    },
    "requested_by": {
      "type": "string",
      "description": "Email of the career counsellor who submitted the request"
    },
    "requested_by_name": {
      "type": "string",
      "description": "Name of the career counsellor who submitted the request"
    },
    "assigned_worker": {
      "type": "string",
      "description": "Email of the client's assigned career counsellor"
    },
    "notes": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected",
        "needs_more_info"
      ],
      "default": "pending"
    },
    "received_by": {
      "type": "string",
      "description": "Email of the manager/admin who acknowledged they will handle this request"
    },
    "received_by_name": {
      "type": "string",
      "description": "Name of the manager/admin who acknowledged they will handle this request"
    },
    "received_date": {
      "type": "string",
      "format": "date",
      "description": "Date the request was acknowledged/received by a manager"
    },
    "reviewed_by": {
      "type": "string",
      "description": "Email of the manager/admin who made the determination"
    },
    "reviewed_by_name": {
      "type": "string",
      "description": "Name of the manager/admin who made the determination"
    },
    "reviewed_date": {
      "type": "string",
      "format": "date",
      "description": "Date the determination was made"
    },
    "determination_date": {
      "type": "string",
      "format": "date",
      "description": "Date the most recent determination was made"
    },
    "rejection_reason": {
      "type": "string",
      "description": "Reason provided when a request is rejected"
    },
    "needs_more_info_note": {
      "type": "string",
      "description": "Note describing what additional information is needed from the requester"
    },
    "purchase_date": {
      "type": "string",
      "format": "date",
      "description": "Date the approved purchase was made"
    },
    "amount_without_tax": {
      "type": "number",
      "description": "Purchase amount excluding tax (the reimbursable amount)"
    },
    "tax": {
      "type": "number",
      "description": "Tax portion of the purchase (documented only \u2014 never included in billing/reimbursement tallies)"
    },
    "total": {
      "type": "number",
      "description": "Total of the purchase (amount_without_tax + tax)"
    },
    "pickup_instructions": {
      "type": "string",
      "description": "Instructions for the requester on picking up the purchased item"
    },
    "purchase_notes": {
      "type": "string",
      "description": "Notes attached by the manager when marking a purchase complete"
    },
    "receipt_url": {
      "type": "string",
      "description": "Uploaded receipt/invoice for the approved purchase"
    },
    "linked_financial_record_id": {
      "type": "string",
      "description": "ID of the FinancialRecord auto-created in billing when this purchase was approved"
    }
  },
  "required": [
    "client_id",
    "support_type",
    "estimated_amount"
  ]
}