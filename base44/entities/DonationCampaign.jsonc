{
  "name": "DonationCampaign",
  "type": "object",
  "description": "A fundraising appeal or campaign the donor portal tracks gifts against \u2014 e.g. Winter Warmth Appeal. Each campaign can publish its own public page with its story, progress and giving options, where supporters give online. A campaign may also be split into fundraising pillars, offer charitable gifting with greeting cards, and issue certificates; those capabilities are switched on per campaign. Gifts point at it by id, so progress updates automatically as donations are recorded.",
  "properties": {
    "name": {
      "type": "string",
      "description": "Campaign name as donors see it"
    },
    "slug": {
      "type": "string",
      "description": "Web address of the campaign's public page \u2014 the page lives at /campaign/<slug>. Generated from the name when left blank."
    },
    "tagline": {
      "type": "string",
      "description": "One short line under the campaign title on the public page"
    },
    "description": {
      "type": "string",
      "description": "What the campaign raises money for (shown in the staff campaign list and at the top of the public page)"
    },
    "story": {
      "type": "string",
      "description": "The full appeal copy on the public page \u2014 why it matters, who it helps, what a gift makes possible"
    },
    "campaign_type": {
      "type": "string",
      "enum": [
        "appeal",
        "event",
        "grant_match",
        "capital",
        "general",
        "other"
      ],
      "default": "appeal"
    },
    "goal_amount": {
      "type": "number",
      "description": "Amount the campaign is trying to raise"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether the campaign still accepts gifts"
    },
    "owner_name": {
      "type": "string",
      "description": "Staff member running the campaign"
    },
    "contact_email": {
      "type": "string",
      "description": "Where questions about this campaign go \u2014 shown on the public page"
    },
    "hero_image_url": {
      "type": "string",
      "description": "Main photo at the top of the public page (publicly stored file URL)"
    },
    "seasonal_theme": {
      "type": "string",
      "enum": [
        "none",
        "christmas"
      ],
      "enumColors": [
        "gray",
        "red"
      ],
      "default": "none",
      "description": "Seasonal dressing for this campaign's public page. none = the site's normal look; christmas = festive accents, used only where a campaign asks for it."
    },
    "public_page_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Whether the campaign's public page is live and can accept online gifts"
    },
    "is_private": {
      "type": "boolean",
      "default": false,
      "description": "Private campaign \u2014 its page still opens for anyone holding the link, but it never appears in a public list: not on the donation page, the campaign list or the website."
    },
    "is_general_fund": {
      "type": "boolean",
      "default": false,
      "description": "Marks this record as the general fund behind the public donation page at /donate. Its giving options are the preset general donations, and it is listed separately from the campaigns shown there."
    },
    "enable_pillars": {
      "type": "boolean",
      "default": false,
      "description": "Run this campaign with fundraising pillars \u2014 each pillar has its own story, goal, giving options and share link, and is reported on its own while staying part of the one campaign."
    },
    "pillars": {
      "type": "array",
      "description": "The causes inside this campaign. A supporter gives to one of them, or to the campaign as a whole.",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Stable id of the pillar, used by giving options and recorded gifts"
          },
          "name": {
            "type": "string",
            "description": "Pillar name as supporters see it, e.g. Joy \u2014 Kids Gift Shop"
          },
          "tagline": {
            "type": "string",
            "description": "One line under the pillar name"
          },
          "description": {
            "type": "string",
            "description": "What gifts to this pillar make possible"
          },
          "image_url": {
            "type": "string",
            "description": "Photo shown on the pillar card (publicly stored file URL)"
          },
          "goal_amount": {
            "type": "number",
            "description": "What this pillar is trying to raise"
          },
          "is_active": {
            "type": "boolean",
            "default": true,
            "description": "Whether the pillar is shown on the public page"
          },
          "display_order": {
            "type": "number",
            "default": 0,
            "description": "Position on the page, lowest first"
          }
        }
      }
    },
    "enable_gifting": {
      "type": "boolean",
      "default": false,
      "description": "Let supporters make their gift in someone's honour \u2014 they choose a greeting card, write a message and pick when it is delivered."
    },
    "ecard_themes": {
      "type": "array",
      "description": "The greeting card designs a supporter can choose when they make a gift in someone's honour.",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Stable id of this card design"
          },
          "name": {
            "type": "string",
            "description": "How the design is labelled for supporters, e.g. Snowy evening"
          },
          "image_url": {
            "type": "string",
            "description": "Artwork of the card (publicly stored file URL)"
          },
          "message": {
            "type": "string",
            "description": "The greeting written inside the card when the supporter leaves their own message blank"
          },
          "is_active": {
            "type": "boolean",
            "default": true,
            "description": "Whether supporters can pick this design"
          },
          "display_order": {
            "type": "number",
            "default": 0
          }
        }
      }
    },
    "certificate_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Issue a personalized certificate with every gift made in someone's honour, ready for the recipient to open and print."
    },
    "certificate_title": {
      "type": "string",
      "description": "Heading on the certificate, e.g. Certificate of Giving"
    },
    "certificate_message": {
      "type": "string",
      "description": "The wording of the certificate, shown under the heading"
    },
    "certificate_signature": {
      "type": "string",
      "description": "Name signed on the certificate"
    },
    "certificate_signature_title": {
      "type": "string",
      "description": "Role under the signature, e.g. Executive Director"
    },
    "allow_custom_amount": {
      "type": "boolean",
      "default": true,
      "description": "Whether supporters may give an amount of their own choosing instead of one of the set options"
    },
    "allow_monthly": {
      "type": "boolean",
      "default": true,
      "description": "Whether supporters may repeat their gift every month"
    },
    "allow_fee_coverage": {
      "type": "boolean",
      "default": true,
      "description": "Whether the giving box offers supporters a checkbox to cover the card processing fee, so the full gift reaches the campaign"
    },
    "donation_products": {
      "type": "array",
      "description": "The giving options offered on the campaign page \u2014 e.g. $50 supplies a week of lunches. Each option becomes a line item at checkout and is created as its own product and price in Stripe automatically. An option can offer several price variations, can let the supporter name their own amount, and can be attached to one pillar.",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Stable id of this option within the campaign"
          },
          "name": {
            "type": "string",
            "description": "Short label, e.g. Sponsor a lunch"
          },
          "description": {
            "type": "string",
            "description": "What this gift makes possible"
          },
          "pillar_id": {
            "type": "string",
            "description": "The pillar this option belongs to. Empty means the option is for the campaign as a whole."
          },
          "amount": {
            "type": "number",
            "description": "Gift amount for this option in CAD. When the option has price variations this mirrors the first variation; when the supporter names their own amount it is the starting amount shown on the page."
          },
          "allow_monthly": {
            "type": "boolean",
            "default": true,
            "description": "Whether this option can be repeated monthly"
          },
          "is_active": {
            "type": "boolean",
            "default": true,
            "description": "Whether the option shows on the public page"
          },
          "allow_custom_price": {
            "type": "boolean",
            "default": false,
            "description": "Whether the supporter may enter their own amount for this option instead of a fixed price"
          },
          "variations": {
            "type": "array",
            "description": "Different prices for the same product, e.g. One week $25 / One month $90. Each variation becomes its own price in Stripe; the supporter picks one on the public page.",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "description": "Stable id of this variation within the option"
                },
                "label": {
                  "type": "string",
                  "description": "How the variation reads on the page, e.g. One week of lunches"
                },
                "amount": {
                  "type": "number",
                  "description": "Price of this variation in CAD"
                },
                "stripe_price_id": {
                  "type": "string",
                  "description": "Stripe price created for this variation"
                },
                "stripe_price_amount": {
                  "type": "number",
                  "description": "Amount of the Stripe price currently attached \u2014 a change in amount creates a new price"
                }
              }
            }
          },
          "display_order": {
            "type": "number",
            "default": 0,
            "description": "Position on the page, lowest first"
          },
          "stripe_product_id": {
            "type": "string",
            "description": "Stripe product created for this giving option"
          },
          "stripe_price_id": {
            "type": "string",
            "description": "Current Stripe price for this giving option"
          },
          "stripe_price_amount": {
            "type": "number",
            "description": "Amount of the Stripe price currently attached \u2014 a change in amount creates a new price"
          }
        }
      }
    },
    "thank_you_message": {
      "type": "string",
      "description": "Message shown to a supporter after their gift goes through"
    },
    "tax_receipt_note": {
      "type": "string",
      "description": "Receipt wording shown under the giving options, e.g. Tax receipts are issued for gifts of $20 or more."
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}