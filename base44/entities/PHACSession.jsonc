{
  "name": "PHACSession",
  "type": "object",
  "properties": {
    "program_id": {
      "type": "string",
      "description": "Reference to PHACProgram"
    },
    "program_name": {
      "type": "string",
      "description": "Denormalized program name"
    },
    "session_date": {
      "type": "string",
      "format": "date",
      "description": "Date of the drop-in session (base date for recurring sessions)"
    },
    "start_time": {
      "type": "string",
      "description": "Start time (HH:MM)"
    },
    "end_time": {
      "type": "string",
      "description": "End time (HH:MM)"
    },
    "location": {
      "type": "string",
      "description": "Location for this session"
    },
    "room": {
      "type": "string",
      "enum": [
        "large_classroom",
        "small_classroom",
        "employment_classroom",
        "arc",
        "virtual",
        "other"
      ],
      "description": "Assigned room (Large Classroom, Small Classroom, Employment Classroom, ARC, Virtual, or Other space)"
    },
    "recurrence_pattern": {
      "type": "string",
      "enum": [
        "none",
        "weekly",
        "biweekly",
        "monthly"
      ],
      "default": "none",
      "description": "How the session recurs from the base date (expanded on the Central Registration calendar)"
    },
    "recurrence_end_date": {
      "type": "string",
      "format": "date",
      "description": "Last recurrence date (blank for a one-off session)"
    },
    "facilitator": {
      "type": "string",
      "description": "Who facilitated this session"
    },
    "attendee_count": {
      "type": "number",
      "default": 0,
      "description": "Number of attendees (headcount)"
    },
    "adult_count": {
      "type": "number",
      "default": 0,
      "description": "Number of adults/parents"
    },
    "child_count": {
      "type": "number",
      "default": 0,
      "description": "Number of children"
    },
    "status": {
      "type": "string",
      "enum": [
        "scheduled",
        "completed",
        "cancelled"
      ],
      "default": "scheduled",
      "description": "Session status"
    },
    "notes": {
      "type": "string",
      "description": "Session notes / observations"
    }
  },
  "required": [
    "program_id",
    "session_date"
  ]
}