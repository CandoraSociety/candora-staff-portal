{
  "name": "WorkExposurePlacement",
  "type": "object",
  "properties": {
    "client_id": {
      "type": "string",
      "description": "Linked Client ID"
    },
    "client_name": {
      "type": "string",
      "description": "Denormalized client full name"
    },
    "employer_id": {
      "type": "string",
      "description": "Linked Employer ID (Candora Central employer record). When set, business_name mirrors the employer's company name."
    },
    "business_name": {
      "type": "string",
      "description": "Name of the business/employer"
    },
    "location": {
      "type": "string",
      "description": "Business address or location"
    },
    "position_type": {
      "type": "string",
      "description": "Type of position (e.g. Warehouse, Retail, Office)"
    },
    "expected_hours_per_week": {
      "type": "number",
      "description": "Expected hours per week"
    },
    "hours_worked": {
      "type": "number",
      "description": "Total hours worked during the placement \u2014 auto-aggregated from employer/staff hours submissions"
    },
    "hourly_rate": {
      "type": "number",
      "default": 15,
      "description": "Rate per hour (default $15/hr)"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "anticipated_completion_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "in_progress",
        "completed",
        "cancelled"
      ],
      "default": "pending"
    },
    "assigned_worker": {
      "type": "string",
      "description": "Email of assigned career counsellor"
    },
    "assigned_worker_name": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "cancellation_reason": {
      "type": "string",
      "description": "Reason for cancellation"
    }
  },
  "required": [
    "client_id",
    "business_name"
  ]
}