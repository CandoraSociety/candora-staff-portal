{
  "name": "ELLClass",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Class/course name"
    },
    "clb_level": {
      "type": "string",
      "enum": [
        "clb_1",
        "clb_2",
        "clb_3",
        "clb_4",
        "clb_5",
        "clb_6",
        "clb_7",
        "clb_8",
        "clb_9",
        "clb_10",
        "clb_11",
        "clb_12",
        "mixed"
      ],
      "default": "mixed",
      "description": "CLB level targeted by this class"
    },
    "description": {
      "type": "string",
      "description": "Class description / curriculum summary"
    },
    "instructor_id": {
      "type": "string",
      "description": "Reference to ELLInstructor"
    },
    "instructor_name": {
      "type": "string",
      "description": "Instructor name (denormalized for display)"
    },
    "course_id": {
      "type": "string",
      "description": "Reference to the ELLClass course this class belongs to \u2014 links the class to the course whose lesson plans / course material applies to it"
    },
    "schedule_days": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "monday",
          "tuesday",
          "wednesday",
          "thursday",
          "friday",
          "saturday",
          "sunday"
        ]
      },
      "description": "Days of the week the class meets"
    },
    "start_time": {
      "type": "string",
      "description": "Start time (HH:MM format)"
    },
    "end_time": {
      "type": "string",
      "description": "End time (HH:MM format)"
    },
    "location": {
      "type": "string",
      "description": "Room or location where the class meets"
    },
    "room": {
      "type": "string",
      "enum": [
        "large_classroom",
        "small_classroom",
        "employment_classroom",
        "other"
      ],
      "description": "Assigned room (Large Classroom, Small Classroom, Employment Classroom, or Other space)"
    },
    "capacity": {
      "type": "number",
      "default": 15,
      "description": "Maximum number of learners"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "description": "Class start date"
    },
    "end_date": {
      "type": "string",
      "format": "date",
      "description": "Class end date"
    },
    "status": {
      "type": "string",
      "enum": [
        "planning",
        "active",
        "completed",
        "cancelled"
      ],
      "default": "planning",
      "description": "Class status"
    },
    "color": {
      "type": "string",
      "default": "#2563eb",
      "description": "Accent colour used for the class card"
    },
    "attendance": {
      "type": "array",
      "description": "Per-date attendance records for this class",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "format": "date",
            "description": "Class date this attendance was taken for"
          },
          "statuses": {
            "type": "object",
            "description": "Map of learner ID -> present | absent | late"
          },
          "recorded_by_name": {
            "type": "string"
          },
          "recorded_date": {
            "type": "string",
            "description": "ISO timestamp of when attendance was saved"
          }
        },
        "required": [
          "id",
          "date"
        ]
      }
    },
    "notes": {
      "type": "array",
      "description": "Class notes log \u2014 newest entries appended, history preserved",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "note": {
            "type": "string"
          },
          "created_by_name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "note"
        ]
      }
    },
    "lesson_plans": {
      "type": "array",
      "description": "Lesson plans \u2014 created in-app (content) or uploaded as files (file_url)",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "format": "date",
            "description": "Class date this lesson plan is for"
          },
          "content": {
            "type": "string",
            "description": "Lesson plan text (created in-app)"
          },
          "file_url": {
            "type": "string",
            "description": "Uploaded lesson plan file URL"
          },
          "file_name": {
            "type": "string",
            "description": "Uploaded lesson plan file name"
          },
          "source_course_name": {
            "type": "string",
            "description": "Name of the course this plan was attached from (course material attached to a class)"
          },
          "created_by_name": {
            "type": "string"
          },
          "created_date": {
            "type": "string",
            "format": "date"
          }
        },
        "required": [
          "id",
          "title"
        ]
      }
    }
  },
  "required": [
    "name"
  ]
}