{
  "name": "ChildmindingRecord",
  "type": "object",
  "properties": {
    "child_first_name": {
      "type": "string",
      "description": "Child's first name"
    },
    "parent_first_name": {
      "type": "string",
      "description": "Parent/guardian's first name"
    },
    "parent_last_name": {
      "type": "string",
      "description": "Parent/guardian's last name"
    },
    "parent_name": {
      "type": "string",
      "description": "Denormalized parent/guardian full name"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Date of childminding session"
    },
    "check_in_time": {
      "type": "string",
      "description": "Check-in time (HH:MM 24h)"
    },
    "check_out_time": {
      "type": "string",
      "description": "Check-out time (HH:MM 24h)"
    },
    "hours": {
      "type": "number",
      "description": "Calculated hours of childminding (from check-in/out, rounded up to nearest 15 min)",
      "default": 0
    },
    "program": {
      "type": "string",
      "enum": [
        "pathways",
        "ell",
        "other"
      ],
      "description": "Program the parent/guardian is attending while child is in childminding"
    },
    "program_other": {
      "type": "string",
      "description": "Specify program if 'other'"
    },
    "billing_amount": {
      "type": "number",
      "default": 0,
      "description": "Calculated billing: hours \u00d7 $20 for Pathways, $0 for others"
    },
    "billing_status": {
      "type": "string",
      "enum": [
        "unbilled",
        "billed",
        "paid",
        "n/a"
      ],
      "default": "unbilled",
      "description": "Billing status (only Pathways is billed)"
    },
    "session_id": {
      "type": "string",
      "description": "Linked ChildmindingSession ID \u2014 set when this intake was added from within a session. When set, the record is shown inside that session rather than as a standalone calendar entry."
    },
    "document_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Supporting document URLs attached to this childminding record (e.g. attendance sheets, sign-in sheets) for billing submission"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "child_first_name",
    "parent_first_name",
    "parent_last_name",
    "date",
    "hours",
    "program"
  ]
}