{
  "name": "ProgramReferral",
  "type": "object",
  "description": "A referral of a person into one of Candora's internal programs. Shows on the receiving program's portal and in Central Registration.",
  "properties": {
    "client_id": {
      "type": "string",
      "description": "Pathways client file this referral came from"
    },
    "rc_client_id": {
      "type": "string",
      "description": "Candora Central Database (RCClient) record this referral came from \u2014 set when referred from the central client file or from another program portal"
    },
    "client_name": {
      "type": "string",
      "description": "Client's full name (denormalized for the receiving program's dashboard)"
    },
    "client_phone": {
      "type": "string"
    },
    "client_email": {
      "type": "string"
    },
    "program": {
      "type": "string",
      "enum": [
        "ell",
        "empoweru",
        "frn",
        "phac",
        "digital_literacy",
        "family_programs",
        "childcare_program",
        "settlement_services",
        "other_internal"
      ],
      "description": "Receiving Candora program \u2014 decides which portal dashboard shows this referral"
    },
    "source_label": {
      "type": "string",
      "description": "Where the referral was made from, e.g. Candora Central Database, FRN, PHAC, EmpowerU, ELL"
    },
    "referred_by_name": {
      "type": "string",
      "description": "Staff member who made the referral"
    },
    "referred_by_email": {
      "type": "string"
    },
    "referral_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "contacted",
        "completed",
        "declined"
      ],
      "default": "new",
      "description": "Progress on the receiving program's side"
    },
    "notes": {
      "type": "string",
      "description": "Receiving program's notes on the referral"
    },
    "handled_by_name": {
      "type": "string"
    },
    "handled_date": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "client_name",
    "program",
    "referral_date"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}