{
  "name": "AppChangeRequest",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Short title/summary of the request"
    },
    "request_text": {
      "type": "string",
      "description": "The full suggestion/request details"
    },
    "submitted_by_name": {
      "type": "string",
      "description": "Full name of the staff member who submitted"
    },
    "submitted_by_email": {
      "type": "string",
      "description": "Email of the staff member who submitted"
    },
    "category": {
      "type": "string",
      "enum": [
        "adjustment",
        "addition",
        "change_request",
        "bug",
        "other"
      ],
      "default": "change_request",
      "description": "Type of request"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "reviewed",
        "in_progress",
        "completed",
        "dismissed"
      ],
      "default": "new",
      "description": "Processing status of the request"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the request was marked complete \u2014 the submitter is notified on their Dashboard at that moment"
    },
    "completed_by_name": {
      "type": "string",
      "description": "Who marked the request complete"
    },
    "admin_message": {
      "type": "string",
      "description": "Latest message from the app administrator to the submitter about this request (e.g. asking for clarification). Sent to the submitter's Dashboard as a notification."
    },
    "admin_message_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the administrator's message was sent"
    },
    "admin_message_by_name": {
      "type": "string",
      "description": "Who sent the administrator's message"
    }
  },
  "required": [
    "request_text",
    "submitted_by_email"
  ]
}