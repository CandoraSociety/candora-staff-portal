{
  "description": "When a Client record is updated, re-sync that one client's row into every open monthly CRT workbook via a targeted single-row PATCH. Skips clients not yet assigned to a program stream or without a start date, and skips closed/frozen months. The daily 15:00 MT full sync is the safety net.",
  "name": "CRT Sync on Client Update",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "crt_sync_on_client_update",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "syncClientToCrt",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "trigger": {
    "condition": "${ (.trigger.data.roadmap_progress_notes[0].item_key // \"\") != \"crt_crossref_update\" or (.trigger.data.roadmap_progress_notes[0].id // \"\") == (.trigger.old_data.roadmap_progress_notes[0].id // \"\") }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create",
        "update"
      ],
      "entity_name": "Client"
    }
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "syncClientToCrt"
  }
}