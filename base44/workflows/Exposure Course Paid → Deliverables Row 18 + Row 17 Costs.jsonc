{
  "name": "Exposure Course Paid \u2192 Deliverables Row 18 + Row 17 Costs",
  "description": "When an exposure_course FinancialRecord is marked reimbursed (paid), add 1 to Exposure Courses - # of clients attended (row 18) and refresh Exposure Courses - Costs (row 17 = CF + CG) in that month's Deliverables sheet.",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"reimbursed\") != null) and (.trigger.data.reimbursed == true) and (.trigger.old_data.reimbursed == false) and (.trigger.data.record_type == \"exposure_course\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "FinancialRecord"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "exposure_course_paid_deliverables_row_18_row_17_costs",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "syncPayableDeliverablesToCrt",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "syncPayableDeliverablesToCrt"
  }
}