{
  "name": "Annual Donation Tax Receipts",
  "description": "Every January 2, issues one consolidated tax receipt to each supporter who gave monthly during the year, emails it to them, and marks those gifts receipted",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 9 2 1 *",
      "one_time_date": null,
      "timezone": "America/Cambridge_Bay",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "annual_donation_tax_receipts",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "issue_annual_receipts": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendAnnualDonationReceipts",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Issue one receipt per monthly donor",
            "description": "Covers the year just ended"
          }
        }
      }
    ]
  }
}