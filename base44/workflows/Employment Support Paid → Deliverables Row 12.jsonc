{
  "name": "Employment Support Paid \u2192 Deliverables Row 12",
  "description": "When an employment_supports FinancialRecord is marked reimbursed (paid), add 1 to the Employment Supports running total (row 12) in that month's Deliverables sheet.",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"reimbursed\") != null) and (.trigger.data.reimbursed == true) and (.trigger.old_data.reimbursed == false) and (.trigger.data.record_type == \"employment_supports\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "FinancialRecord"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "employment_support_paid_deliverables_row_12",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "syncPayableDeliverablesToCrt",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "syncPayableDeliverablesToCrt"
  }
}