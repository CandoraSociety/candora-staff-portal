{
  "name": "EmpowerU Tracker Sync on Participant Update",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create",
        "update"
      ],
      "entity_name": "EmpowerUParticipant"
    }
  },
  "description": "Updates the cohort's official funder-reporting Excel workbook when an EmpowerU participant's details change (name, phone, email).",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "empoweru_tracker_sync_participant",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "sync_tracker_row": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "syncEmpowerUParticipantToTracker",
            "args": {
              "participant_id": "${ .trigger.entity_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Sync participant details to official tracker",
            "description": "Updates the cohort Excel workbook"
          }
        }
      }
    ]
  }
}