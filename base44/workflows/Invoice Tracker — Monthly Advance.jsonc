{
  "name": "Invoice Tracker \u2014 Monthly Advance",
  "description": "Fills column D = 1 on the active CRT workbook's Invoice Tracker sheet for every month from April 2026 up to and including the current reporting month. Runs monthly so the new current month is marked as reported; idempotent (skips rows already marked 1).",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 9 1 * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "invoice_tracker_monthly_advance",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "advanceInvoiceTracker",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "advanceInvoiceTracker"
  }
}