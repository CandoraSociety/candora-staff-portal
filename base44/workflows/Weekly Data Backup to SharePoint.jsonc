  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 3 * * 6",
      "one_time_date": null,
      "timezone": "America/Edmonton",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "name": "Weekly Data Backup to SharePoint",
  "description": "Every Saturday at 3:00am, exports all app data (clients, billing, staff, every portal) to CSV files stored under the '_PRIVATE_ Data Backups' folder inside each portal's SharePoint folder. Each step backs up one portal's group."
