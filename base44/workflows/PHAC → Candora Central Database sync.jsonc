{
  "name": "PHAC \u2192 Candora Central Database sync",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create",
        "update"
      ],
      "entity_name": "PHACParticipant"
    }
  },
  "description": "Auto-create/update a Candora Central Database record from a PHAC participant (child, with parent/guardian contact) \u2014 uses a staff-linked central file when one exists, otherwise matches or creates one \u2014 and maintains the PHAC indicator (registered / waitlisted / withdrawn).",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "phac_central_database_sync",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "sync_participant": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "syncPHACParticipantToCentralDb",
            "args": {
              "participant_id": "${ .trigger.entity_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Sync PHAC participant to Central Database",
            "description": "Link or create the client file"
          }
        }
      }
    ]
  }
}