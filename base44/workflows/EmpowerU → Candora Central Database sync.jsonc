{
  "name": "EmpowerU \u2192 Candora Central Database sync",
  "description": "Auto-create/update a Candora Central Database (RCClient) record from an EmpowerU participant, mirroring a condensed profile and maintaining an EmpowerU program-participation indicator.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create",
        "update"
      ],
      "entity_name": "EmpowerUParticipant"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "empoweru_candora_central_database_sync",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "syncEmpowerUParticipantToCentralDb",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "syncEmpowerUParticipantToCentralDb"
  }
}